pipeline {    agent any        triggers {        pollSCM('H/5 * * * *') // vérifie toutes les 5 minutes (plus raisonnable)    }        stages {        // ----------------------------        // 1. Checkout code        // ----------------------------        stage('Checkout') {            steps {                script {                    // Checkout avec récupération des tags                    checkout([                        $class: 'GitSCM',                        branches: [[name: '*/dev']],                        userRemoteConfigs: [[url: 'https://github.com/hanineBaccar123/Projet-Devops.git']],                        extensions: [                            [$class: 'CloneOption', noTags: false, shallow: false],                            [$class: 'LocalBranch', localBranch: '**']                        ]                    ])                                        // Détecte si on est sur un tag                    env.GIT_TAG_NAME = bat(                        script: '@git describe --tags --exact-match 2>nul || echo',                        returnStdout: true                    ).trim()                                        echo "GIT_TAG_NAME détecté: ${env.GIT_TAG_NAME}"                }            }        }                // ----------------------------        // 2. Install Frontend        // ----------------------------        stage('Install Frontend') {            options { timeout(time: 20, unit: 'MINUTES') }            steps {                dir('FrontendElearning') {                    bat 'npm install --no-progress --silent'                }            }        }                // ----------------------------        // 3. Install Backend        // ----------------------------        stage('Install Backend') {            options { timeout(time: 20, unit: 'MINUTES') }            steps {                dir('BackendElearning') {                    bat 'npm install --no-progress --silent'                }            }        }                // ----------------------------        // 4. Run Smoke Tests        // ----------------------------        stage('Run Smoke Tests') {            steps {                script {                    // Tests Frontend                    def frontendTest = bat(                        script: '@if exist smoketest.sh (smoketest.sh) else (echo "No frontend smoke test")',                        returnStatus: true                    )                    echo "Frontend Smoke Test: ${frontendTest == 0 ? 'PASSED' : 'FAILED'}"                                        // Tests Backend                    def backendTest = bat(                        script: '@if exist smoketestbackend.sh (smoketestbackend.sh) else (echo "No backend smoke test")',                        returnStatus: true                    )                    echo "Backend Smoke Test: ${backendTest == 0 ? 'PASSED' : 'FAILED'}"                                        // Tests Full                    def fullTest = bat(                        script: '@if exist smoke_test_full.sh (smoke_test_full.sh) else (echo "No full smoke test")',                        returnStatus: true                    )                    echo "Full Smoke Test: ${fullTest == 0 ? 'PASSED' : 'FAILED'}"                }            }        }                // ----------------------------        // 5. Build Complet sur dev        // ----------------------------        stage('Build Complet') {            when {                 allOf {                    branch 'dev'                    expression { env.GIT_TAG_NAME == null || env.GIT_TAG_NAME == '' }                }            }            steps {                echo 'Building Frontend...'                dir('FrontendElearning') {                    bat 'npm run build'                }                echo 'Building Backend...'                dir('BackendElearning') {                    bat 'npm run build'                }                echo 'Build complet terminé ?'            }        }                // ----------------------------        // 6. Build versionné sur tag vX.Y.Z        // ----------------------------        stage('Build Versionné & Archive') {            when {                 expression {                     env.GIT_TAG_NAME != null &&                     env.GIT_TAG_NAME != '' &&                     env.GIT_TAG_NAME ==~ /^v\d+\.\d+\.\d+.*$/                }            }            steps {                script {                    def version = env.GIT_TAG_NAME                    echo "========================================="                    echo "BUILD VERSIONNÉ - Version: ${version}"                    echo "========================================="                                        // Build Frontend avec version                    echo "Building Frontend ${version}..."                    dir('FrontendElearning') {                        // Injecte la version dans package.json si nécessaire                        bat """                            @echo off                            echo Building frontend version ${version}                            npm run build                        """                    }                                        // Build Backend avec version                    echo "Building Backend ${version}..."                    dir('BackendElearning') {                        bat """                            @echo off                            echo Building backend version ${version}                            npm run build                        """                    }                                        // Archive les artefacts                    echo "Archivage des artefacts..."                    archiveArtifacts artifacts: '**/dist/**,**/build/**',                                      allowEmptyArchive: true,                                     fingerprint: true,                                     onlyIfSuccessful: true                                        echo "========================================="                    echo "Artefacts archivés pour ${version} ?"                    echo "========================================="                }            }        }            }        post {        success {            echo "? Pipeline terminé avec SUCCÈS"            script {                if (env.GIT_TAG_NAME && env.GIT_TAG_NAME != '') {                    echo "Version ${env.GIT_TAG_NAME} buildée et archivée avec succès"                }            }        }        failure {            echo "? Pipeline ÉCHOUÉ - Statut: ${currentBuild.currentResult}"        }        always {            echo "Pipeline terminé - Durée: ${currentBuild.durationString}"        }    }}