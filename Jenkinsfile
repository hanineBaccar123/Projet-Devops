pipeline {    agent any    stages {        stage('Checkout') {            steps {                git branch: 'dev',                    url: 'https://github.com/hanineBaccar123/Projet-Devops.git'            }        }        stage('Install Frontend') {            steps {                dir('FrontendElearning') {                    bat 'npm install'                }            }        }        stage('Install Backend') {            steps {                dir('BackendElearning') {                    bat 'npm install'                }            }        }        stage('Run Smoke Tests') {            steps {                bat 'bash smoketest.sh'                bat 'bash smoketestbackend.sh'                bat 'bash smoke_test_full.sh'            }        }    }}