pipeline {    agent any    tools {        nodejs "NodeJS 20" // Assurez-vous de configurer NodeJS dans Jenkins    }    triggers {        // Polling pour dev push et PR (optionnel)        pollSCM('* * * * *')    }    stages {        // ----------------------------        // 1. Checkout code        // ----------------------------        stage('Checkout') {            steps {                git branch: 'dev', url: 'https://github.com/hanineBaccar123/Projet-Devops.git'            }        }        // ----------------------------        // 2. Install Frontend        // ----------------------------        stage('Install Frontend') {            options { timeout(time: 10, unit: 'MINUTES') }            steps {                dir('FrontendElearning') {                    withEnv(["PATH+NODE=${tool 'NodeJS 20'}/bin"]) {                        bat 'npm install --no-progress --silent'                    }                }            }        }        // ----------------------------        // 3. Install Backend        // ----------------------------        stage('Install Backend') {            options { timeout(time: 10, unit: 'MINUTES') }            steps {                dir('BackendElearning') {                    withEnv(["PATH+NODE=${tool 'NodeJS 20'}/bin"]) {                        bat 'npm install --no-progress --silent'                    }                }            }        }        // ----------------------------        // 4. Run Smoke Tests        // ----------------------------        stage('Run Smoke Tests') {            steps {                bat 'smoketest.sh || echo "Frontend Smoke Test Passed/Failed"'                bat 'smoketestbackend.sh || echo "Backend Smoke Test Passed/Failed"'                bat 'smoke_test_full.sh || echo "Full Smoke Test Passed/Failed"'            }        }        // ----------------------------        // 5. Full Build on dev push        // ----------------------------        stage('Build Complet') {            when { branch 'dev' }            steps {                echo 'Building Frontend...'                dir('FrontendElearning') {                    bat 'npm run build -- --silent'                }                echo 'Building Backend...'                dir('BackendElearning') {                    bat 'npm run build -- --silent'                }                echo 'Full Build terminé ?'            }        }        // ----------------------------        // 6. Build versionné sur tag vX.Y.Z        // ----------------------------        stage('Build Versionné & Archive Artefacts') {            when {                expression { env.GIT_TAG_NAME != null } // exécute si c'est un tag            }            steps {                script {                    def version = env.GIT_TAG_NAME ?: "v0.0.0"                    echo "Building version: ${version}"                    dir('FrontendElearning') {                        bat "npm run build -- --version=${version} --silent"                    }                    dir('BackendElearning') {                        bat "npm run build -- --version=${version} --silent"                    }                    archiveArtifacts artifacts: 'FrontendElearning/dist/**,BackendElearning/build/**', fingerprint: true                    echo "Artefacts archivés pour la version ${version} ?"                }            }        }        // ----------------------------        // 7. Cleanup        // ----------------------------        stage('Cleanup') {            steps {                echo "Cleanup workspace"                bat 'rmdir /s /q node_modules || echo "No node_modules to delete"'            }        }    }    post {        always {            echo "Pipeline terminé avec statut: ${currentBuild.currentResult}"        }    }}