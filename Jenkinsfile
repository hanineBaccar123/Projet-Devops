pipeline {    agent any        stages {        stage('Checkout') {            steps {                git branch: 'dev',                     url: 'https://github.com/hanineBaccar123/Projet-Devops.git'            }        }                stage('Install Dependencies') {            steps {                dir('FrontendElearning') {                    bat 'npm install'                }            }        }                stage('Run Tests') {            steps {                dir('FrontendElearning') {                    bat 'npm test'                }            }        }                stage('Smoke Test') {            steps {                dir('FrontendElearning') {                    bat 'somektest.bat'                }            }        }    }}