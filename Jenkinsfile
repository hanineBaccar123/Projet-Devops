pipeline {    agent any    triggers {        // On peut garder le polling sur dev si besoin        pollSCM('* * * * *')    }    stages {        stage('Checkout') {            steps {                git branch: 'dev', url: 'https://github.com/hanineBaccar123/Projet-Devops.git'            }        }        stage('Install Frontend') {            steps {                dir('FrontendElearning') {                    bat 'npm install'                }            }        }        stage('Install Backend') {            steps {                dir('BackendElearning') {                    bat 'npm install'                }            }        }        stage('Run Smoke Tests') {            steps {                bat 'smoketest.sh'                bat 'smoketestbackend.sh'                bat 'smoke_test_full.sh'            }        }        // ----------------------------        // 2. Full Build on dev push        // ----------------------------        stage('Build Complet') {            when { branch 'dev' }            steps {                echo 'Building Frontend...'                dir('FrontendElearning') {                    bat 'npm run build'                }                echo 'Building Backend...'                dir('BackendElearning') {                    bat 'npm run build'                }                echo 'Build complet terminé '            }        }        // ----------------------------        // 3. Build versionné sur tag vX.Y.Z        // ----------------------------        stage('Build Versionné & Archive Artefacts') {            when {                expression {                    // On build seulement si c'est un tag                    return env.GIT_TAG_NAME != null                }            }            steps {                script {                    def version = env.GIT_TAG_NAME ?: "v0.0.0"                    echo "Building version: ${version}"                    // Build Frontend et Backend avec version                    dir('FrontendElearning') {                        bat "npm run build -- --version=${version}"                    }                    dir('BackendElearning') {                        bat "npm run build -- --version=${version}"                    }                    // Archiver les artefacts (build output)                    archiveArtifacts artifacts: 'FrontendElearning/dist/**, BackendElearning/build/**', fingerprint: true                    echo "Artefacts archivés pour la version ${version} "                }            }        }    }}