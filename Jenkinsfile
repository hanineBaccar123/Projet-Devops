pipeline {    agent any        stages {        stage('Checkout') {            steps {                git branch: 'dev',                     url: 'https://github.com/hanineBaccar123/Projet-Devops.git'            }        }                stage('Build Frontend Image') {            steps {                dir('FrontendElearning') {                    bat 'docker build -t myapp-frontend .'                }            }        }                stage('Run Frontend') {            steps {                bat 'docker run -d -p 3000:3000 --name frontend myapp-frontend'            }        }                stage('Smoke Test Frontend') {            steps {                dir('FrontendElearning') {                    bat './somektest.sh'                }            }        }    }        post {        always {            bat 'docker stop frontend || exit 0'            bat 'docker rm frontend || exit 0'        }    }}