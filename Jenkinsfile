pipeline {    agent any        stages {        stage('Checkout') {            steps {                git branch: 'dev',                     url: 'https://github.com/hanineBaccar123/Projet-Devops.git'            }        }                stage('Install Dependencies') {            steps {                dir('FrontendElearning') {                    bat 'npm install'                }            }        }                stage('Verify Installation') {            steps {                dir('FrontendElearning') {                    bat 'npm list --depth=0'                    bat 'echo Installation successful!'                }            }        }    }}