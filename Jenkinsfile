pipeline {         agent any          triggers {        // Déclenche le pipeline automatiquement sur push sur dev        pollSCM('* * * * *') // vérifie le repo toutes les minutes    }          stages {        stage('Checkout') {            steps {                git branch: 'dev', url: 'https://github.com/hanineBaccar123/Projet-Devops.git'            }        }          stage('Install Frontend') {            steps {                dir('FrontendElearning') {                    bat 'npm install'                }            }        }          stage('Install Backend') {            steps {                dir('BackendElearning') {                    bat 'npm install'                }            }        }          stage('Run Smoke Tests') {            steps {                bat 'smoketest.sh'                bat 'smoketestbackend.sh'                bat 'smoke_test_full.sh'            }        }          // ----------------------------        // 2. Full Build on dev push        // ----------------------------        stage('Build Complet') {            when {                branch 'dev' // uniquement si push sur dev            }            steps {                echo 'Building Frontend...'                dir('FrontendElearning') {                    bat 'npm run build'                }                  echo 'Building Backend...'                dir('BackendElearning') {                    bat 'npm run build' // si tu as un script build pour backend                }                  echo 'Build complet terminé '            }        }    }}