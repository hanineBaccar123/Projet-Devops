pipeline {    agent any    // Déclenchement automatique à chaque push sur dev    triggers {        pollSCM('* * * * *') // ou webhook Git pour push    }    environment {        BACKEND_URL = 'http://localhost:5001'        FRONTEND_URL = 'http://localhost:5371'    }    stages {        // ----------------------------        // 1?? : Checkout        // ----------------------------        stage('Checkout') {            steps {                echo "Récupération du code source..."                checkout scm            }        }        // ----------------------------        // 2?? : Setup        // ----------------------------        stage('Setup') {            steps {                echo "Vérification de Docker et Docker Compose..."                bat 'docker --version'                bat 'docker-compose --version'            }        }        // ----------------------------        // 3?? : Build        // ----------------------------        stage('Build') {            steps {                echo "Construction des images Docker..."                bat 'docker-compose build'            }        }        // ----------------------------        // 4?? : Run (Docker)        // ----------------------------        stage('Run (Docker)') {            steps {                echo "Arrêt et suppression des containers existants..."                bat 'powershell -Command "docker ps -a -q | ForEach-Object { docker rm -f $_ }"'                bat 'docker network prune -f'                echo "Démarrage des containers..."                bat 'docker-compose up -d --force-recreate'                sleep 10 // laisser le backend démarrer            }        }        // ----------------------------        // 5?? : Smoke Test (VERSION CORRECTE)        // ----------------------------        stage('Smoke Test') {            steps {                script {                    echo "Exécution des tests de santé..."                    // ---- BACKEND ----                    def backendCode = bat(                        script: "curl.exe -s -o NUL -w %%{http_code} ${env.BACKEND_URL}",                        returnStdout: true                    ).trim()                    echo "Backend Status Code: ${backendCode}"                    if (backendCode != "200") {                        error "Backend smoke test failed ! Code : ${backendCode}"                    }                    // ---- FRONTEND ----                    def frontendCode = bat(                        script: "curl.exe -s -o NUL -w %%{http_code} ${env.FRONTEND_URL}",                        returnStdout: true                    ).trim()                    echo "Frontend Status Code: ${frontendCode}"                    if (frontendCode != "200") {                        error "Frontend smoke test failed ! Code : ${frontendCode}"                    }                    echo "Tous les services répondent correctement."                }            }        }        // ----------------------------        // 6?? : Archive Artifacts        // ----------------------------        stage('Archive Artifacts') {            steps {                echo "Archivage des artefacts..."                archiveArtifacts artifacts: '**/build/**, **/logs/**', allowEmptyArchive: true            }        }        // ----------------------------        // 7?? : Cleanup        // ----------------------------        stage('Cleanup') {            steps {                echo "Nettoyage complet des containers et réseaux Docker..."                bat 'docker-compose down --remove-orphans'                bat 'powershell -Command "docker ps -a -q | ForEach-Object { docker rm -f $_ }"'                bat 'docker network prune -f'            }        }    }    // ----------------------------    // POST ACTIONS    // ----------------------------    post {        failure {            echo "Le pipeline a échoué"            bat 'docker-compose down --remove-orphans || true'            bat 'powershell -Command "docker ps -a -q | ForEach-Object { docker rm -f $_ }"'            bat 'docker network prune -f'        }        success {            echo "Pipeline terminé avec succès"        }    }}