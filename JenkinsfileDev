pipeline {    agent any    environment {        BACKEND_PORT = "5001"        FRONTEND_PORT = "5371"        ARTIFACTS_DIR = "artifacts"    }    triggers {        pollSCM('* * * * *') // déclenchement automatique sur branche dev    }    stages {        stage('Checkout') {            steps {                echo "?? Checkout dev..."                checkout scm            }        }        stage('Setup') {            steps {                echo "??? Installation outils..."                bat 'docker --version || echo Docker non trouvé'                bat 'docker-compose --version || echo docker-compose non trouvé'                bat 'if not exist "artifacts" mkdir "artifacts"'             }        }        stage('Build Backend') {            steps {                echo "?? Build image backend..."                bat 'docker build -t backend-dev -f Dockerfilebackend .'            }        }        stage('Build Frontend') {            steps {                echo "?? Build image frontend..."                bat 'docker build -t frontend-dev -f Dockerfilefrontend .'            }        }        stage('Run Docker') {            steps {                echo "?? Démarrage containers dev..."                bat 'docker-compose up -d'                bat 'ping 127.0.0.1 -n 10 > nul' // attendre que les containers soient prêts            }        }        stage('Smoke Test') {            steps {                echo "? Smoke Test dev..."                bat 'smoke_test_full.sh || exit 1'            }        }        stage('Archive Artifacts') {            steps {                echo "?? Archivage logs et rapports..."                archiveArtifacts artifacts: "%ARTIFACTS_DIR%\\**", allowEmptyArchive: true            }        }    }    post {        always {            echo "?? Cleanup containers dev..."            bat 'docker-compose down || echo Pas de containers à arrêter'        }        success {            echo "?? Pipeline dev réussi"        }        failure {            echo "? Pipeline dev échoué"        }    }}