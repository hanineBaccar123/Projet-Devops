pipeline {    agent any    // Déclenchement automatique à chaque push sur dev    triggers {        pollSCM('* * * * *') // ou webhook Git pour push    }    environment {        BACKEND_URL = 'http://localhost:5001'        FRONTEND_URL = 'http://localhost:5371'    }    stages {        // ----------------------------        // 1?? Checkout        // ----------------------------        stage('Checkout') {            steps {                echo "Récupération du code source..."                checkout scm            }        }        // ----------------------------        // 2?? Setup        // ----------------------------        stage('Setup') {            steps {                echo "Vérification de Docker et Docker Compose..."                bat 'docker --version'                bat 'docker-compose --version'            }        }        // ----------------------------        // 3?? Build        // ----------------------------        stage('Build') {            steps {                echo "Construction des images Docker..."                bat 'docker-compose build'            }        }        // ----------------------------        // 4?? Run (Docker)        // ----------------------------        stage('Run (Docker)') {            steps {                echo "Arrêt et suppression des containers existants..."                // Nettoyage complet pour éviter conflit de nom                bat 'powershell -Command "docker ps -a -q | ForEach-Object { docker rm -f $_ }"'                bat 'docker network prune -f'                echo "Démarrage des containers..."                bat 'docker-compose up -d --force-recreate'            }        }        // ----------------------------        // 5?? Smoke Test        // ----------------------------        stage('Smoke Test') {            steps {                script {                    echo "Exécution des tests de santé..."                    def backendCode = bat(script: "curl -s -o NUL -w \"%{http_code}\" %BACKEND_URL%", returnStdout: true).trim()                    if (backendCode != '200') {                        error "Backend smoke test failed!"                    }                    def frontendCode = bat(script: "curl -s -o NUL -w \"%{http_code}\" %FRONTEND_URL%", returnStdout: true).trim()                    if (frontendCode != '200') {                        error "Frontend smoke test failed!"                    }                    echo "Tous les services répondent correctement."                }            }        }        // ----------------------------        // 6?? Archive Artifacts        // ----------------------------        stage('Archive Artifacts') {            steps {                echo "Archivage des artefacts..."                archiveArtifacts artifacts: '**/build/**, **/logs/**', allowEmptyArchive: true            }        }        // ----------------------------        // 7?? Cleanup (recommandé)        // ----------------------------        stage('Cleanup') {            steps {                echo "Nettoyage complet des containers et réseaux Docker..."                bat 'powershell -Command "docker ps -a -q | ForEach-Object { docker rm -f $_ }"'                bat 'docker network prune -f'            }        }    }    // ----------------------------    // Post Actions    // ----------------------------    post {        failure {            echo "Le pipeline a échoué"            bat 'powershell -Command "docker ps -a -q | ForEach-Object { docker rm -f $_ }"'            bat 'docker network prune -f'        }        success {            echo "Pipeline terminé avec succès"        }    }}