pipeline {  agent any  triggers {    pollSCM('* * * * *')   // toutes les minutes  }  environment {    ARTIFACTS_DIR = "artifacts"    FRONTEND_PORT = "5371"    BACKEND_PORT  = "5001"  }  stages {    /* ------------------- CHECKOUT --------------------- */    stage('Checkout') {      steps {        echo "Checkout du code source"        checkout scm      }    }    /* ------------------- SETUP --------------------- */    stage('Setup') {      steps {        echo "Setup: vérifier outils"        bat 'node -v || echo node not found'        bat 'docker --version'        bat 'docker-compose --version || echo docker-compose not found'        // créer artifacts (important !!)        bat "if not exist ${env.ARTIFACTS_DIR} mkdir ${env.ARTIFACTS_DIR}"      }    }    /* ------------------- BUILD (PARALLEL) --------------------- */    stage('Build') {      parallel {        stage('Build - frontend (node 18)') {          steps {            echo 'Build image FRONTEND'            bat "if not exist ${env.ARTIFACTS_DIR} mkdir ${env.ARTIFACTS_DIR}"            bat """              docker build --build-arg NODE_VERSION=18 -t myapp-frontend:${env.BUILD_ID} ./frontend ^              > ${env.ARTIFACTS_DIR}\\frontend-build-${env.BUILD_ID}.log 2>&1            """            archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/frontend-build-${env.BUILD_ID}.log", fingerprint: true          }        }        stage('Build - backend (node 18)') {          steps {            echo 'Build image BACKEND'            bat "if not exist ${env.ARTIFACTS_DIR} mkdir ${env.ARTIFACTS_DIR}"            bat """              docker build --build-arg NODE_VERSION=18 -t myapp-backend:${env.BUILD_ID} ./backend ^              > ${env.ARTIFACTS_DIR}\\backend-build-${env.BUILD_ID}.log 2>&1            """            archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/backend-build-${env.BUILD_ID}.log", fingerprint: true          }        }      }    }    /* ------------------- RUN (DOCKER COMPOSE) --------------------- */    stage('Run (Docker)') {      steps {        echo "Run docker-compose"        bat "docker-compose -f docker-compose.yml up -d > ${env.ARTIFACTS_DIR}\\docker-up-${env.BUILD_ID}.log 2>&1"        archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/docker-up-${env.BUILD_ID}.log"        bat 'TIMEOUT /T 5 /NOBREAK'      }    }    /* ------------------- SMOKE TEST --------------------- */    stage('Smoke Test') {      steps {        echo "Smoke Test API /health"        bat """          node smoke/smoke.js http://localhost:${env.BACKEND_PORT}/health ^          > ${env.ARTIFACTS_DIR}\\smoke-${env.BUILD_ID}.txt 2>&1        """        archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/smoke-${env.BUILD_ID}.txt"        bat "findstr /C:\"SMOKE PASSED\" ${env.ARTIFACTS_DIR}\\smoke-${env.BUILD_ID}.txt"      }      post {        failure {          echo "Smoke Test FAILED ?"        }      }    }    /* ------------------- ARCHIVE --------------------- */    stage('Archive Artifacts') {      steps {        echo "Archivage complet"        archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/**", fingerprint: true      }    }    /* ------------------- CLEANUP --------------------- */    stage('Cleanup') {      steps {        echo "Nettoyage Docker"        bat "docker-compose -f docker-compose.yml down > ${env.ARTIFACTS_DIR}\\docker-down-${env.BUILD_ID}.log 2>&1 || echo ignore"        bat "docker rmi myapp-backend:${env.BUILD_ID} myapp-frontend:${env.BUILD_ID} || echo ignore"        archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/docker-down-${env.BUILD_ID}.log"      }    }  } // end stages  post {    success {      echo "Pipeline DEV SUCCEEDED ?"    }    failure {      echo "Pipeline DEV FAILED ?"    }    always {      echo "Pipeline terminé."    }  }}