pipeline {    agent any    environment {        BACKEND_PORT = "5001"        FRONTEND_PORT = "5371"        ARTIFACTS_DIR = "artifacts"    }    triggers {        // Ce pipeline sera déclenché par les PR vers dev (via plugin GitHub/Bitbucket)    }    stages {        stage('Checkout') {            steps {                echo "?? Checkout code source..."                checkout scm            }        }        stage('Setup') {            steps {                echo "?? Setup outils..."                bat 'docker --version || echo Docker non trouvé'                bat 'docker-compose --version || echo docker-compose non trouvé'                bat 'mkdir %ARTIFACTS_DIR%'            }        }        stage('Build Docker Images') {            parallel {                stage('Build Backend') {                    steps { bat 'docker build -t backend-dev -f DockerfileBackend .' }                }                stage('Build Frontend') {                    steps { bat 'docker build -t frontend-dev -f DockerfileFrontend .' }                }            }        }        stage('Run Docker') {            steps {                echo "?? Démarrage containers..."                bat 'docker-compose up -d'                bat 'ping 127.0.0.1 -n 10 > nul' // attendre que les containers soient prêts            }        }        stage('Smoke Test') {            steps {                echo "?? Exécution Smoke Test..."                bat 'smoke_test_full.sh || exit 1'            }        }        stage('Archive Artifacts') {            steps {                echo "?? Archivage..."                archiveArtifacts artifacts: "%ARTIFACTS_DIR%\\**", allowEmptyArchive: true            }        }    }    post {        always {            echo "?? Cleanup containers..."            bat 'docker-compose down || echo Pas de containers à arrêter'        }        success { echo "? Pipeline PR réussi" }        failure { echo "? Pipeline PR échoué" }    }}