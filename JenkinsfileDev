// Jenkinsfile.dev - Pipeline declarative (Windows agent)pipeline {  agent any  triggers {    // utilisez webhook GitHub si possible; pollSCM en fallback (toutes les minutes)    pollSCM('@midnight') // change si tu préfères webhook  }  environment {    ARTIFACTS_DIR = "artifacts"    FRONTEND_PORT = "5371"   // changement si tu veux    BACKEND_PORT  = "5001"  }  stages {    stage('Checkout') {      steps {        echo "Checkout from ${env.dev}"        checkout scm      }    }    stage('Setup') {      steps {        echo "Setup: installer dépendances for CI"        // example: install node if needed, or show versions        bat 'node -v || echo node not found'        bat 'docker --version'        bat 'docker-compose --version || echo docker-compose not found'      }    }    stage('Build') {      parallel {        stage('Build - frontend (node 18)') {          steps {            echo 'Building frontend docker image (node 18)'            bat "docker build --build-arg NODE_VERSION=18 -t myapp-frontend:${env.BUILD_ID} ./frontend > ${env.ARTIFACTS_DIR}\\frontend-build-${env.BUILD_ID}.log 2>&1"            archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/frontend-build-${env.BUILD_ID}.log", fingerprint: true          }        }        stage('Build - backend (node 18)') {          steps {            echo 'Building backend docker image (node 18)'            bat "docker build --build-arg NODE_VERSION=18 -t myapp-backend:${env.BUILD_ID} ./backend > ${env.ARTIFACTS_DIR}\\backend-build-${env.BUILD_ID}.log 2>&1"            archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/backend-build-${env.BUILD_ID}.log", fingerprint: true          }        }      }    }    stage('Run (Docker)') {      steps {        echo "Run service via docker-compose (detached)"        // create artifacts dir        bat "if not exist ${env.ARTIFACTS_DIR} mkdir ${env.ARTIFACTS_DIR}"        // bring up containers (compose file should refer to local built images by tag)        bat "docker-compose -f docker-compose.yml up -d > ${env.ARTIFACTS_DIR}\\docker-up-${env.BUILD_ID}.log 2>&1"        archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/docker-up-${env.BUILD_ID}.log"        // give services a moment to start        bat 'TIMEOUT /T 5 /NOBREAK'      }    }    stage('Smoke Test') {      steps {        echo "Lancer smoke tests contre backend"        // lancer script node smoke (retournera non-zero si fail)        bat "node smoke/smoke.js http://localhost:${env.BACKEND_PORT}/health > ${env.ARTIFACTS_DIR}\\smoke-${env.BUILD_ID}.txt 2>&1"        // publisher artifact smoke result        archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/smoke-${env.BUILD_ID}.txt"        // lecture du fichier pour décider        bat "findstr /R /C:\"SMOKE PASSED\" ${env.ARTIFACTS_DIR}\\smoke-${env.BUILD_ID}.txt"      }      post {        failure {          echo "Smoke tests failed — marquer l'étape comme failed"        }      }    }    stage('Archive Artifacts') {      steps {        echo "Archiver logs, build artifacts et rapports"        // Archiver tout dossier artifacts        archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/**", fingerprint: true        // éventuellement publier un rapport junit si tu as des tests        // junit allowEmptyResults: true, testResults: 'reports/test-*.xml'      }    }    stage('Cleanup') {      steps {        echo "Cleanup: down containers and remove images created for this build"        bat "docker-compose -f docker-compose.yml down > ${env.ARTIFACTS_DIR}\\docker-down-${env.BUILD_ID}.log 2>&1 || echo ignore"        // supprime images taggées par BUILD_ID        bat "docker rmi myapp-backend:${env.BUILD_ID} myapp-frontend:${env.BUILD_ID} || echo ignore"        archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/docker-down-${env.BUILD_ID}.log"      }    }  } // stages  post {    success {      echo "Pipeline DEV succeeded"    }    failure {      echo "Pipeline DEV failed"    }    always {      echo "FINISHED: archiving pipeline log"      // tu peux ajouter upload d'autres rapports ici    }  }}