pipeline {    agent any        environment {        BUILD_VERSION = "dev-${BUILD_NUMBER}"    }        stages {        stage('1?? Checkout') {            steps {                echo '?? Checking out dev branch...'                checkout scm                bat 'git log -1'            }        }                stage('2?? Setup') {            steps {                echo '?? Setup Environment...'                bat '''                    echo Build Version: %BUILD_VERSION%                    echo Build Number: %BUILD_NUMBER%                    if not exist artifacts\\dev-%BUILD_NUMBER% mkdir artifacts\\dev-%BUILD_NUMBER%                '''            }        }                stage('3?? Build') {            parallel {                stage('Verify Backend') {                    steps {                        echo '? Backend container already built'                        bat '''                            docker ps --filter name=backend --format "Backend: {{.Status}}"                            docker inspect backend --format="Image: {{.Config.Image}}"                        '''                    }                }                stage('Verify Frontend') {                    steps {                        echo '? Frontend container already built'                        bat '''                            docker ps --filter name=frontend --format "Frontend: {{.Status}}"                            docker inspect frontend --format="Image: {{.Config.Image}}"                        '''                    }                }                stage('Verify MongoDB') {                    steps {                        echo '? MongoDB container already built'                        bat '''                            docker ps --filter name=mongodb --format "MongoDB: {{.Status}}"                            docker exec mongodb mongosh -u admin -p password123 --authenticationDatabase admin --eval "db.version()"                        '''                    }                }            }        }                stage('4?? Run Docker') {            steps {                echo '?? Docker Status...'                bat '''                    echo === Running Containers ===                    docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"                                        echo.                    echo === Container Health ===                    docker stats --no-stream backend frontend mongodb                '''            }        }                stage('5?? Smoke Test') {            steps {                echo '?? Running Smoke Tests...'                bat '''                    call smoketest.bat > artifacts\\dev-%BUILD_NUMBER%\\smoke-results.txt 2>&1                '''            }        }                stage('6?? Archive Artifacts') {            steps {                echo '?? Archiving Dev Build Artifacts...'                bat '''                    echo ======================================= > artifacts\\dev-%BUILD_NUMBER%\\build-info.txt                    echo     DEV BUILD REPORT >> artifacts\\dev-%BUILD_NUMBER%\\build-info.txt                    echo ======================================= >> artifacts\\dev-%BUILD_NUMBER%\\build-info.txt                    echo Build Number:    %BUILD_NUMBER% >> artifacts\\dev-%BUILD_NUMBER%\\build-info.txt                    echo Build Version:   %BUILD_VERSION% >> artifacts\\dev-%BUILD_NUMBER%\\build-info.txt                    echo Build Date:      %date% %time% >> artifacts\\dev-%BUILD_NUMBER%\\build-info.txt                    echo Container State: Running (Pre-built) >> artifacts\\dev-%BUILD_NUMBER%\\build-info.txt                    echo ======================================= >> artifacts\\dev-%BUILD_NUMBER%\\build-info.txt                                        REM Container Logs                    docker logs backend --tail 200 > artifacts\\dev-%BUILD_NUMBER%\\backend.log 2>&1                    docker logs frontend --tail 200 > artifacts\\dev-%BUILD_NUMBER%\\frontend.log 2>&1                    docker logs mongodb --tail 200 > artifacts\\dev-%BUILD_NUMBER%\\mongodb.log 2>&1                                        REM Container Info                    docker inspect backend > artifacts\\dev-%BUILD_NUMBER%\\backend-inspect.json                    docker inspect frontend > artifacts\\dev-%BUILD_NUMBER%\\frontend-inspect.json                    docker inspect mongodb > artifacts\\dev-%BUILD_NUMBER%\\mongodb-inspect.json                '''                archiveArtifacts artifacts: 'artifacts/dev-*/**/*', allowEmptyArchive: true            }        }                stage('7?? Cleanup') {            steps {                echo '?? Cleanup...'                bat 'echo Containers remain running - No cleanup needed'            }        }    }        post {        success {            echo '? -----------------------------------'            echo '?   DEV BUILD PASSED'            echo '? -----------------------------------'            echo "?? Build ${BUILD_VERSION} completed successfully!"        }        failure {            echo '? -----------------------------------'            echo '?   DEV BUILD FAILED'            echo '? -----------------------------------'        }        always {            echo '?? Dev Pipeline Completed'        }    }}