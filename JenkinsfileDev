pipeline {    agent any    triggers {        pollSCM('H/5 * * * *') // Toutes les 5 minutes    }    environment {        BACKEND_URL = 'http://localhost:5001'        FRONTEND_URL = 'http://localhost:5371'        DOCKER_COMPOSE_FILE = 'docker-compose.yml'        BUILD_ID = "${env.BUILD_NUMBER}"    }    options {        timeout(time: 30, unit: 'MINUTES')        buildDiscarder(logRotator(numToKeepStr: '10'))        disableConcurrentBuilds()        skipDefaultCheckout(true) // Évite le double checkout    }    stages {        // ----------------------------        // 1. Préparation et Checkout        // ----------------------------        stage('Préparation') {            steps {                echo "?? Démarrage du pipeline - Build #${env.BUILD_NUMBER}"                echo "Workspace: ${env.WORKSPACE}"            }        }        stage('Checkout SCM') {            steps {                echo "?? Récupération du code source..."                checkout scm                                dir('.') {                    bat '''                        echo "=== Structure du projet ==="                        dir /B                        echo.                        echo "=== Fichiers Docker ==="                        dir /B docker-compose.yml Dockerfile* 2>nul || echo "Fichiers Docker non trouvés"                    '''                }            }        }        // ----------------------------        // 2. Validation et Setup        // ----------------------------        stage('Validation Environnement') {            steps {                echo "?? Validation de l'environnement..."                                script {                    // Vérification des outils requis                    def dockerVersion = bat(                        script: 'docker --version',                        returnStdout: true                    ).trim()                    echo "Docker: ${dockerVersion}"                                        def composeVersion = bat(                        script: 'docker-compose --version',                        returnStdout: true                    ).trim()                    echo "Docker Compose: ${composeVersion}"                                        // Vérification de la présence des fichiers Docker                    def dockerFiles = bat(                        script: 'dir /B docker-compose.yml Dockerfile* 2>nul || echo "Fichiers non trouvés"',                        returnStdout: true                    ).trim()                    echo "Fichiers Docker trouvés: ${dockerFiles}"                }            }        }        // ----------------------------        // 3. Nettoyage Préalable (Sécurisé)        // ----------------------------        stage('Nettoyage Préalable') {            steps {                echo "?? Nettoyage de l'environnement..."                                script {                    try {                        // Arrêt des services Docker Compose s'ils existent                        bat 'docker-compose down --remove-orphans --timeout 30 2>nul || echo "Aucun service Docker Compose à arrêter"'                    } catch (Exception e) {                        echo "??  Avertissement lors de l'arrêt Docker Compose: ${e.message}"                    }                                        try {                        // Nettoyage des containers arrêtés                        bat 'for /f "tokens=*" %i in (\'docker ps -aq --filter "status=exited"\') do docker rm -f %i 2>nul || echo "Aucun container à supprimer"'                    } catch (Exception e) {                        echo "??  Avertissement lors du nettoyage des containers: ${e.message}"                    }                                        try {                        // Nettoyage des réseaux                        bat 'docker network prune -f 2>nul || echo "Aucun réseau à nettoyer"'                    } catch (Exception e) {                        echo "??  Avertissement lors du nettoyage des réseaux: ${e.message}"                    }                                        echo "? Nettoyage terminé"                }            }        }        // ----------------------------        // 4. Construction des Images        // ----------------------------        stage('Build Images') {            steps {                echo "?? Construction des images Docker..."                                script {                    try {                        // Build avec logs détaillés                        bat '''                            echo "Construction des images en cours..."                            docker-compose build --no-cache --progress plain                                                        echo "=== Vérification des images construites ==="                            docker images | findstr "pipelinedev" || echo "Aucune image pipelinedev trouvée"                        '''                                                // Vérification que les images ont été créées                        def images = bat(                            script: 'docker images --format "table {{.Repository}}\\t{{.Tag}}\\t{{.Size}}" | findstr "pipelinedev"',                            returnStdout: true                        ).trim()                                                if (!images) {                            echo "??  Aucune image pipelinedev trouvée, vérification de toutes les images..."                            bat 'docker images'                            error "? Les images n'ont pas été construites correctement"                        }                        echo "? Images construites avec succès:\n${images}"                                            } catch (Exception e) {                        echo "? Échec de la construction des images"                        // Tentative de récupération des logs                        bat 'docker-compose logs || echo "Impossible de récupérer les logs"'                        throw e                    }                }            }        }        // ----------------------------        // 5. Déploiement des Services        // ----------------------------        stage('Déploiement') {            steps {                echo "?? Démarrage des services..."                                script {                    try {                        // Démarrage des services                        bat '''                            echo "Démarrage des services avec Docker Compose..."                            docker-compose up -d --force-recreate                        '''                                                // Attente du démarrage                        sleep 15                                                // Vérification de l'état des containers                        def status = bat(                            script: 'docker-compose ps',                            returnStdout: true                        ).trim()                        echo "État des containers:\n${status}"                                            } catch (Exception e) {                        echo "? Échec du déploiement"                        bat 'docker-compose logs --tail=50'                        throw e                    }                }            }        }        // ----------------------------        // 6. Vérification des Services        // ----------------------------        stage('Vérification Services') {            steps {                echo "?? Vérification du statut des services..."                                script {                    sleep 10 // Attente supplémentaire                                        def status = bat(                        script: 'docker-compose ps',                        returnStdout: true                    ).trim()                    echo "État détaillé des containers:\n${status}"                                        // Vérification que tous les containers sont running                    def runningCount = bat(                        script: 'docker-compose ps --services --filter "status=running" | find /c /v ""',                        returnStdout: true                    ).trim()                                        def totalCount = bat(                        script: 'docker-compose config --services | find /c /v ""',                        returnStdout: true                    ).trim()                                        echo "Containers running: ${runningCount}/${totalCount}"                                        if (runningCount != totalCount) {                        bat 'docker-compose logs --tail=30'                        error "? Certains containers ne sont pas en cours d'exécution"                    }                                        echo "? Tous les containers sont en cours d'exécution"                }            }        }        // ----------------------------        // 7. Tests de Santé        // ----------------------------        stage('Tests de Santé') {            steps {                echo "?? Tests de santé des services..."                                script {                    // Test Backend avec retry                    echo "Testing Backend sur ${env.BACKEND_URL}"                                        def backendHealthy = false                    def maxRetries = 15                    def retryDelay = 5                                        for (int i = 1; i <= maxRetries; i++) {                        try {                            echo "Tentative ${i}/${maxRetries} pour le backend..."                                                        def healthCheck = bat(                                script: """                                    curl.exe -s -o NUL -w "%%{http_code}" --connect-timeout 10 --max-time 15 "${env.BACKEND_URL}/api/health" || echo "000"                                """,                                returnStdout: true                            ).trim()                                                        echo "Backend HTTP Code: ${healthCheck}"                                                        if (healthCheck == "200") {                                echo "? Backend répond correctement"                                backendHealthy = true                                break                            } else {                                echo "??  Backend non prêt (HTTP ${healthCheck}), attente ${retryDelay}s..."                                                                // Affichage des logs périodiquement                                if (i % 5 == 0) {                                    echo "=== Logs du backend (tentative ${i}) ==="                                    bat 'docker-compose logs backend --tail=20'                                }                                                                sleep retryDelay                            }                        } catch (Exception e) {                            echo "? Erreur lors du test du backend: ${e.message}"                            sleep retryDelay                        }                    }                                        if (!backendHealthy) {                        bat 'docker-compose logs backend --tail=50'                        error "? Le backend n'est pas devenu healthy après ${maxRetries} tentatives"                    }                                        // Test Frontend                    echo "Testing Frontend sur ${env.FRONTEND_URL}"                                        def frontendHealthy = false                    for (int i = 1; i <= 10; i++) {                        try {                            def frontendCheck = bat(                                script: """                                    curl.exe -s -o NUL -w "%%{http_code}" --connect-timeout 10 "${env.FRONTEND_URL}" || echo "000"                                """,                                returnStdout: true                            ).trim()                                                        echo "Frontend HTTP Code: ${frontendCheck}"                                                        if (frontendCheck == "200" || frontendCheck == "304") {                                echo "? Frontend répond correctement"                                frontendHealthy = true                                break                            } else {                                echo "??  Frontend non prêt (HTTP ${frontendCheck}), attente 3s..."                                sleep 3                            }                        } catch (Exception e) {                            echo "? Erreur lors du test du frontend: ${e.message}"                            sleep 3                        }                    }                                        if (!frontendHealthy) {                        bat 'docker-compose logs frontend --tail=30'                        error "? Le frontend n'est pas devenu healthy après 10 tentatives"                    }                                        echo "?? Tous les tests de santé sont passés avec succès!"                }            }        }        // ----------------------------        // 8. Tests Fonctionnels        // ----------------------------        stage('Tests Fonctionnels') {            steps {                echo "?? Tests fonctionnels de base..."                                script {                    // Test des endpoints API principaux                    def endpoints = [                        "${env.BACKEND_URL}/api/health",                        "${env.BACKEND_URL}/api/courses",                        "${env.BACKEND_URL}/api/users"                    ]                                        endpoints.each { endpoint ->                        try {                            def response = bat(                                script: """                                    curl.exe -s -w "URL: %%{url_effective} | HTTP: %%{http_code} | Temps: %%{time_total}s\\n" --connect-timeout 10 "${endpoint}" || echo "? Échec de la requête"                                """,                                returnStdout: true                            ).trim()                            echo "Test ${endpoint}: ${response}"                        } catch (Exception e) {                            echo "??  Erreur sur ${endpoint}: ${e.message}"                        }                    }                                        echo "? Tests fonctionnels terminés"                }            }        }        // ----------------------------        // 9. Archivage        // ----------------------------        stage('Archivage') {            steps {                echo "?? Archivage des artefacts..."                                script {                    // Sauvegarde des informations de build                    bat """                        echo "Build Information" > build_info.txt                        echo "Build Number: ${env.BUILD_NUMBER}" >> build_info.txt                        echo "Build URL: ${env.BUILD_URL}" >> build_info.txt                        echo "Date: %DATE% %TIME%" >> build_info.txt                        docker-compose images >> build_info.txt 2>nul || echo "Impossible de récupérer les images" >> build_info.txt                    """                                        archiveArtifacts artifacts: 'build_info.txt', fingerprint: true                                        // Sauvegarde des logs en cas de succès                    bat '''                        docker-compose logs > docker_logs.log 2>&1 || echo "Impossible de sauvegarder les logs" > docker_logs.log                    '''                    archiveArtifacts artifacts: 'docker_logs.log', allowEmptyArchive: true                }            }        }    }    // ----------------------------    // ACTIONS POST-BUILD    // ----------------------------    post {        always {            echo "?? Nettoyage post-build..."                        script {                // Sauvegarde des logs en cas d'échec                if (currentBuild.result != 'SUCCESS') {                    bat '''                        echo "=== Sauvegarde des logs pour investigation ==="                        docker-compose logs --tail=100 > failure_logs.log 2>&1 || echo "Impossible de récupérer les logs"                        docker-compose ps -a > failure_ps.log 2>&1                    '''                    archiveArtifacts artifacts: 'failure_logs.log, failure_ps.log', allowEmptyArchive: true                }                                // Nettoyage propre des ressources (sécurisé)                bat '''                    echo "Arrêt des services..."                    docker-compose down --remove-orphans --timeout 30 2>nul || echo "Aucun service à arrêter"                                        echo "Nettoyage des ressources Docker..."                    docker system prune -f 2>nul || echo "Nettoyage déjà effectué"                '''                                // Rapport de build                def duration = currentBuild.durationString                echo "?? Build ${currentBuild.result} - Durée: ${duration}"            }        }                success {            echo "?? Pipeline exécuté avec succès!"            // Notification basique            bat '''                echo "? Build réussi!"            '''        }                failure {            echo "?? Pipeline échoué - investigation nécessaire"            // Conservation des containers pour debug            bat '''                echo "=== État actuel des containers ==="                docker-compose ps -a                echo.                echo "=== Logs récents ==="                docker-compose logs --tail=30            '''        }                unstable {            echo "??  Pipeline instable"        }    }}