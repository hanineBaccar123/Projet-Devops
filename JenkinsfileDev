pipeline {    agent any    triggers {        pollSCM('H/5 * * * *') // Toutes les 5 minutes au lieu de toutes les minutes    }    environment {        BACKEND_URL = 'http://localhost:5001'        FRONTEND_URL = 'http://localhost:5371'        DOCKER_COMPOSE_FILE = 'docker-compose.yml'        BUILD_ID = "${env.BUILD_NUMBER}"    }    options {        timeout(time: 30, unit: 'MINUTES')        buildDiscarder(logRotator(numToKeepStr: '10'))        disableConcurrentBuilds()    }    stages {        // ----------------------------        // 1. Préparation et Checkout        // ----------------------------        stage('Préparation') {            steps {                echo "?? Démarrage du pipeline - Build #${env.BUILD_NUMBER}"                echo "Branch: ${env.GIT_BRANCH}"                echo "Commit: ${env.GIT_COMMIT}"            }        }        stage('Checkout SCM') {            steps {                echo "?? Récupération du code source..."                checkout([                    $class: 'GitSCM',                    branches: [[name: '*/dev']],                    extensions: [                        [                            $class: 'CleanCheckout',                            deleteUntrackedNestedRepositories: true                        ],                        [                            $class: 'RelativeTargetDirectory',                            relativeTargetDir: 'src'                        ]                    ],                    userRemoteConfigs: [[                        credentialsId: 'dockerhub-creds',                        url: 'https://github.com/hanineBaccar123/Projet-Devops'                    ]]                ])                                // Vérification de la structure du projet                dir('src') {                    bat 'dir && echo "=== Structure du projet ===" && tree /F /A || echo "tree non disponible, utilisation de dir" && dir /S'                }            }        }        // ----------------------------        // 2. Validation et Setup        // ----------------------------        stage('Validation Environnement') {            steps {                echo "?? Validation de l'environnement..."                                script {                    // Vérification des outils requis                    def dockerVersion = bat(                        script: 'docker --version',                        returnStdout: true                    ).trim()                    echo "Docker: ${dockerVersion}"                                        def composeVersion = bat(                        script: 'docker-compose --version',                        returnStdout: true                    ).trim()                    echo "Docker Compose: ${composeVersion}"                                        // Vérification de la présence des fichiers Docker                    dir('src') {                        def files = bat(                            script: 'dir /B docker-compose.yml Dockerfile* 2>nul || echo "Fichiers non trouvés"',                            returnStdout: true                        ).trim()                        echo "Fichiers Docker trouvés: ${files}"                    }                }            }        }        // ----------------------------        // 3. Nettoyage Préalable        // ----------------------------        stage('Nettoyage Préalable') {            steps {                echo "?? Nettoyage de l'environnement..."                                script {                    // Arrêt et suppression des containers existants                    bat '''                        echo "Arrêt des containers en cours..."                        docker-compose down --remove-orphans --timeout 30 2>nul || echo "Aucun container à arrêter"                                                echo "Nettoyage des containers orphelins..."                        docker ps -a -q --filter "status=exited" | ForEach-Object { docker rm -f $_ } 2>nul || echo "Aucun container à supprimer"                                                echo "Nettoyage des réseaux..."                        docker network prune -f 2>nul || echo "Aucun réseau à nettoyer"                                                echo "Nettoyage des images intermédiaires..."                        docker image prune -f 2>nul || echo "Aucune image à nettoyer"                    '''                }            }        }        // ----------------------------        // 4. Construction des Images        // ----------------------------        stage('Build Images') {            steps {                echo "?? Construction des images Docker..."                                dir('src') {                    script {                        try {                            // Build avec cache et logs détaillés                            bat '''                                echo "Construction des images en cours..."                                docker-compose build --no-cache --progress plain                                                                echo "=== Liste des images construites ==="                                docker images | findstr "pipelinedev"                            '''                                                        // Vérification que les images ont été créées                            def images = bat(                                script: 'docker images --format "table {{.Repository}}\\t{{.Tag}}\\t{{.Size}}" | findstr "pipelinedev"',                                returnStdout: true                            ).trim()                                                        if (!images) {                                error "? Aucune image n'a été construite"                            }                            echo "? Images construites avec succès:\n${images}"                                                    } catch (Exception e) {                            echo "? Échec de la construction des images"                            bat 'docker-compose logs || echo "Impossible de récupérer les logs"'                            throw e                        }                    }                }            }        }        // ----------------------------        // 5. Déploiement des Services        // ----------------------------        stage('Déploiement') {            steps {                echo "?? Démarrage des services..."                                dir('src') {                    script {                        // Démarrage des services                        bat '''                            echo "Démarrage des services avec Docker Compose..."                            docker-compose up -d --force-recreate --no-build                        '''                                                // Attendre que les services démarrent                        sleep 10                                                // Vérification de l'état des containers                        def status = bat(                            script: 'docker-compose ps --format "table {{.Name}}\\t{{.State}}\\t{{.Ports}}"',                            returnStdout: true                        ).trim()                        echo "État des containers:\n${status}"                    }                }            }        }        // ----------------------------        // 6. Vérification des Services        // ----------------------------        stage('Vérification Services') {            steps {                echo "?? Vérification du statut des services..."                                script {                    // Vérification que tous les containers sont running                    def runningContainers = bat(                        script: 'docker-compose ps --services --filter "status=running"',                        returnStdout: true                    ).trim().readLines()                                        def allContainers = bat(                        script: 'docker-compose config --services',                        returnStdout: true                    ).trim().readLines()                                        if (runningContainers.size() != allContainers.size()) {                        echo "??  Certains containers ne sont pas en cours d'exécution"                        bat 'docker-compose ps'                        bat 'docker-compose logs --tail=20'                        error "? Tous les containers ne sont pas démarrés"                    }                                        echo "? Tous les containers sont en cours d'exécution: ${runningContainers}"                }            }        }        // ----------------------------        // 7. Tests de Santé Avancés        // ----------------------------        stage('Tests de Santé') {            steps {                echo "?? Tests de santé des services..."                                script {                    // Test Backend avec retry amélioré                    echo "Testing Backend sur ${env.BACKEND_URL}"                                        def backendHealthy = false                    def maxRetries = 12                    def retryDelay = 10                                        for (int i = 1; i <= maxRetries; i++) {                        try {                            echo "Tentative ${i}/${maxRetries} pour le backend..."                                                        // Vérification multiple du backend                            def healthCheck = bat(                                script: """                                    curl.exe -s -o response.json -w "%{http_code}" --connect-timeout 15 --max-time 20 "${env.BACKEND_URL}/api/health" || echo "000"                                """,                                returnStdout: true                            ).trim()                                                        echo "Backend HTTP Code: ${healthCheck}"                                                        if (healthCheck == "200") {                                echo "? Backend répond correctement"                                backendHealthy = true                                break                            } else {                                echo "??  Backend non prêt (HTTP ${healthCheck}), attente ${retryDelay}s..."                                                                // Affichage des logs pour debug                                if (i % 3 == 0) { // Toutes les 3 tentatives                                    bat 'docker-compose logs backend --tail=30'                                }                                                                sleep retryDelay                            }                        } catch (Exception e) {                            echo "? Erreur lors du test du backend: ${e.message}"                            sleep retryDelay                        }                    }                                        if (!backendHealthy) {                        bat 'docker-compose logs backend --tail=50'                        error "? Le backend n'est pas devenu healthy après ${maxRetries} tentatives"                    }                                        // Test Frontend                    echo "Testing Frontend sur ${env.FRONTEND_URL}"                                        def frontendHealthy = false                    for (int i = 1; i <= 8; i++) {                        try {                            def frontendCheck = bat(                                script: """                                    curl.exe -s -o NUL -w "%{http_code}" --connect-timeout 10 "${env.FRONTEND_URL}" || echo "000"                                """,                                returnStdout: true                            ).trim()                                                        echo "Frontend HTTP Code: ${frontendCheck}"                                                        if (frontendCheck == "200" || frontendCheck == "304") {                                echo "? Frontend répond correctement"                                frontendHealthy = true                                break                            } else {                                echo "??  Frontend non prêt (HTTP ${frontendCheck}), attente 5s..."                                sleep 5                            }                        } catch (Exception e) {                            echo "? Erreur lors du test du frontend: ${e.message}"                            sleep 5                        }                    }                                        if (!frontendHealthy) {                        bat 'docker-compose logs frontend --tail=30'                        error "? Le frontend n'est pas devenu healthy après 8 tentatives"                    }                                        echo "?? Tous les tests de santé sont passés avec succès!"                }            }        }        // ----------------------------        // 8. Tests Fonctionnels        // ----------------------------        stage('Tests Fonctionnels') {            steps {                echo "?? Tests fonctionnels de base..."                                script {                    // Test des endpoints API principaux                    def endpoints = [                        "${env.BACKEND_URL}/api/health",                        "${env.BACKEND_URL}/api/courses",                        "${env.BACKEND_URL}/api/users"                    ]                                        endpoints.each { endpoint ->                        try {                            def response = bat(                                script: """                                    curl.exe -s -w "URL: %{url_effective} | HTTP: %{http_code} | Temps: %{time_total}s\\n" --connect-timeout 10 "${endpoint}" || echo "? Échec de la requête"                                """,                                returnStdout: true                            ).trim()                            echo "Test ${endpoint}: ${response}"                        } catch (Exception e) {                            echo "??  Erreur sur ${endpoint}: ${e.message}"                        }                    }                }            }        }        // ----------------------------        // 9. Archivage et Documentation        // ----------------------------        stage('Archivage') {            steps {                echo "?? Archivage des artefacts..."                                script {                    // Sauvegarde des logs Docker                    bat '''                        echo "=== Sauvegarde des logs ==="                        docker-compose logs > docker_logs.log 2>&1 || echo "Impossible de sauvegarder les logs"                                                echo "=== Configuration des services ==="                        docker-compose config > docker_config.yml 2>&1 || echo "Impossible de sauvegarder la config"                    '''                                        // Archivage des artefacts                    archiveArtifacts(                        artifacts: 'src/docker_logs.log, src/docker_config.yml',                        fingerprint: true,                        allowEmptyArchive: true                    )                                        // Sauvegarde des informations de build                    bat """                        echo "Build Information" > build_info.txt                        echo "Build Number: ${env.BUILD_NUMBER}" >> build_info.txt                        echo "Build URL: ${env.BUILD_URL}" >> build_info.txt                        echo "Git Commit: ${env.GIT_COMMIT}" >> build_info.txt                        echo "Date: %DATE% %TIME%" >> build_info.txt                        docker-compose images >> build_info.txt                    """                                        archiveArtifacts artifacts: 'build_info.txt'                }            }        }    }    // ----------------------------    // ACTIONS POST-BUILD    // ----------------------------    post {        always {            echo "?? Nettoyage post-build..."                        script {                // Sauvegarde des logs en cas d'échec                if (currentBuild.result != 'SUCCESS') {                    bat '''                        echo "=== Sauvegarde des logs pour investigation ==="                        docker-compose logs --tail=100 > failure_logs.log 2>&1 || echo "Impossible de récupérer les logs"                        docker-compose ps -a > failure_ps.log 2>&1                    '''                    archiveArtifacts(                        artifacts: 'failure_logs.log, failure_ps.log',                        allowEmptyArchive: true                    )                }                                // Nettoyage propre des ressources                bat '''                    echo "Arrêt des services..."                    docker-compose down --remove-orphans --timeout 30 2>nul || echo "Aucun service à arrêter"                                        echo "Nettoyage des ressources Docker..."                    docker system prune -f --volumes 2>nul || echo "Nettoyage déjà effectué"                '''            }                        // Rapport de build            script {                def duration = currentBuild.durationString                echo "?? Build ${currentBuild.result} - Durée: ${duration}"                                // Notification basique                if (currentBuild.result == 'SUCCESS') {                    echo "? Pipeline terminé avec succès!"                    emailext (                        subject: "? SUCCÈS: Build ${env.JOB_NAME} #${env.BUILD_NUMBER}",                        body: """                        Le build ${env.BUILD_NUMBER} de ${env.JOB_NAME} a réussi!                                                Détails:                        - Statut: SUCCÈS                        - Durée: ${duration}                        - URL: ${env.BUILD_URL}                        - Commit: ${env.GIT_COMMIT}                        """,                        to: "admin@example.com"                    )                } else if (currentBuild.result == 'FAILURE') {                    echo "? Pipeline échoué"                    emailext (                        subject: "? ÉCHEC: Build ${env.JOB_NAME} #${env.BUILD_NUMBER}",                        body: """                        Le build ${env.BUILD_NUMBER} de ${env.JOB_NAME} a échoué!                                                Détails:                        - Statut: ÉCHEC                        - Durée: ${duration}                        - URL: ${env.BUILD_URL}                        - Commit: ${env.GIT_COMMIT}                                                Consultez les logs pour plus de détails.                        """,                        to: "admin@example.com"                    )                }            }        }                success {            echo "?? Pipeline exécuté avec succès!"            // Cleanup réussi - garder les images pour réutilisation            bat '''                echo "Nettoyage des ressources inutilisées..."                docker image prune -f 2>nul || echo "Aucune image à nettoyer"            '''        }                failure {            echo "?? Pipeline échoué - investigation nécessaire"            // Conservation des containers pour debug en cas d'échec            bat '''                echo "Conservation des containers pour investigation..."                docker-compose ps                echo "=== Logs des derniers erreurs ==="                docker-compose logs --tail=50            '''        }                unstable {            echo "??  Pipeline instable"        }                changed {            echo "?? Statut du pipeline changé"            script {                if (currentBuild.previousBuild) {                    echo "Statut précédent: ${currentBuild.previousBuild.result}"                }            }        }    }}