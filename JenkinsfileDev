pipeline {  agent any    parameters {    booleanParam(name: 'CLEANUP_AFTER_BUILD', defaultValue: false, description: 'Arrêter les conteneurs après le build ?')  }    triggers {    pollSCM('* * * * *')  }    environment {    ARTIFACTS_DIR = "artifacts"    FRONTEND_PORT = "5371"    BACKEND_PORT  = "5001"  }    stages {    /* ------------------- CHECKOUT --------------------- */    stage('Checkout') {      steps {        echo "Checkout du code source"        checkout scm      }    }        /* ------------------- SETUP --------------------- */    stage('Setup') {      steps {        echo "Vérification des outils"        bat 'node -v || echo node not found'        bat 'docker --version'        bat 'docker-compose --version || echo docker-compose not found'        bat "if not exist %ARTIFACTS_DIR% mkdir %ARTIFACTS_DIR%"      }    }        /* ------------------- PRE-CLEANUP --------------------- */    stage('Pre-Cleanup') {      steps {        echo "Suppression des containers existants"        bat """          docker rm -f mongodb > NUL 2>&1 || echo mongodb non existant          docker rm -f backend > NUL 2>&1 || echo backend non existant          docker rm -f frontend > NUL 2>&1 || echo frontend non existant          docker-compose -f docker-compose.yml down > %ARTIFACTS_DIR%\\docker-pre-down-%BUILD_ID%.log 2>&1 || echo docker-compose down non critique        """        archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/docker-pre-down-${env.BUILD_ID}.log", allowEmptyArchive: true      }    }        /* ------------------- BUILD (PARALLEL) --------------------- */    stage('Build') {      parallel {        /* ------------ FRONTEND ------------ */        stage('Build - frontend') {          steps {            echo "Build image frontend"            bat """              if not exist %ARTIFACTS_DIR% mkdir %ARTIFACTS_DIR%              docker build --build-arg NODE_VERSION=20 -t myapp-frontend:%BUILD_ID% -t myapp-frontend:latest -f Dockerfilefrontend . > %ARTIFACTS_DIR%\\frontend-build-%BUILD_ID%.log 2>&1            """            archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/frontend-build-${env.BUILD_ID}.log", fingerprint: true          }        }        /* ------------ BACKEND ------------ */        stage('Build - backend') {          steps {            echo "Build image backend"            bat """              if not exist %ARTIFACTS_DIR% mkdir %ARTIFACTS_DIR%              docker build --build-arg NODE_VERSION=20 -t myapp-backend:%BUILD_ID% -t myapp-backend:latest -f Dockerfilebackend . > %ARTIFACTS_DIR%\\backend-build-%BUILD_ID%.log 2>&1            """            archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/backend-build-${env.BUILD_ID}.log", fingerprint: true          }        }      }    }        /* ------------------- RUN DOCKER --------------------- */    stage('Run Docker') {      steps {        echo "docker-compose up"        bat """          docker-compose -f docker-compose.yml up -d > %ARTIFACTS_DIR%\\docker-up-%BUILD_ID%.log 2>&1        """        archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/docker-up-${env.BUILD_ID}.log", allowEmptyArchive: true        echo "Attente du démarrage des services..."        sleep 10        bat 'docker ps'      }    }        /* ------------------- SMOKE TEST --------------------- */    stage('Smoke Test') {      steps {        echo "Smoke Test Backend /health"        bat """          call smoke_test_full.sh > %ARTIFACTS_DIR%\\smoke-%BUILD_ID%.txt 2>&1        """        archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/smoke-${env.BUILD_ID}.txt", allowEmptyArchive: true        bat "findstr /C:\"BACKEND PASSED\" %ARTIFACTS_DIR%\\smoke-%BUILD_ID%.txt"      }      post {        failure {          echo "Smoke Test FAILED - Affichage des logs"          bat "type %ARTIFACTS_DIR%\\smoke-%BUILD_ID%.txt"          bat "docker logs backend"        }      }    }        /* ------------------- POST-CLEANUP --------------------- */    stage('Post-Cleanup') {      when {        expression { return params.CLEANUP_AFTER_BUILD == true }      }      steps {        echo "Nettoyage Docker (optionnel)"        bat """          docker-compose -f docker-compose.yml down > %ARTIFACTS_DIR%\\docker-down-%BUILD_ID%.log 2>&1 || echo docker-compose down non critique          docker rmi myapp-backend:%BUILD_ID% myapp-frontend:%BUILD_ID% || echo ignore        """        archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/docker-down-${env.BUILD_ID}.log", allowEmptyArchive: true      }    }  }    post {    success {      echo "? Pipeline DEV SUCCEEDED"      echo "Frontend: http://localhost:${env.FRONTEND_PORT}"      echo "Backend: http://localhost:${env.BACKEND_PORT}"    }    failure {      echo "? Pipeline DEV FAILED"      bat "docker ps -a"      bat "docker-compose logs --tail=50"    }    always {      echo "Pipeline terminé - Build #${env.BUILD_ID}"    }  }}