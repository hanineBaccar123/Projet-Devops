pipeline {    agent any    environment {        BACKEND_PORT = "5001"        FRONTEND_PORT = "5371"        ARTIFACTS_DIR = "artifacts"    }    stages {        stage('Checkout') {            steps {                checkout scm            }        }        stage('Build Docker Images') {            steps {                echo 'Building Docker images...'                sh 'docker-compose build'            }        }        stage('Start Containers') {            steps {                echo 'Starting MongoDB...'                sh 'docker-compose up -d mongo'                                echo 'Waiting for MongoDB to be ready...'                sh 'sleep 10'                echo 'Starting Backend and Frontend...'                sh 'docker-compose up -d backend frontend'                                echo 'Waiting for Backend to be ready...'                sh '''                for i in {1..20}; do                    if curl -s http://localhost:${BACKEND_PORT}/health | grep "OK"; then                        echo "Backend is up!"                        exit 0                    else                        echo "Waiting for backend..."                        sleep 3                    fi                done                echo "Backend did not start in time"                exit 1                '''            }        }        stage('Run Smoke Tests') {            steps {                echo 'Running smoke tests...'                sh './smoke_test_full.sh'            }        }    }    post {        always {            echo "Cleaning up Docker containers..."            sh 'docker-compose down'        }        success {            echo "Pipeline succeeded ?"        }        failure {            echo "Pipeline failed ?"        }    }}