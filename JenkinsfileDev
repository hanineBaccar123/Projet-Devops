pipeline {    agent any        environment {        BUILD_VERSION = "dev-${BUILD_NUMBER}"    }        stages {        stage('1?? Checkout') {            steps {                echo '?? Checking out dev branch...'                checkout scm                sh 'git log -1'            }        }                stage('2?? Setup') {            steps {                echo '?? Setup Environment...'                sh '''                    echo "Build Version: ${BUILD_VERSION}"                    echo "Build Number: ${BUILD_NUMBER}"                    mkdir -p artifacts/dev-${BUILD_NUMBER}                '''            }        }                stage('3?? Build') {            parallel {                stage('Verify Backend') {                    steps {                        echo '? Backend container already built'                        sh '''                            docker ps --filter name=backend --format "Backend: {{.Status}}"                            docker inspect backend --format='Image: {{.Config.Image}}' || true                        '''                    }                }                stage('Verify Frontend') {                    steps {                        echo '? Frontend container already built'                        sh '''                            docker ps --filter name=frontend --format "Frontend: {{.Status}}"                            docker inspect frontend --format='Image: {{.Config.Image}}' || true                        '''                    }                }                stage('Verify MongoDB') {                    steps {                        echo '? MongoDB container already built'                        sh '''                            docker ps --filter name=mongodb --format "MongoDB: {{.Status}}"                            docker exec mongodb mongosh --eval "db.version()" || true                        '''                    }                }            }        }                stage('4?? Run Docker') {            steps {                echo '?? Docker Status...'                sh '''                    echo "=== Running Containers ==="                    docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"                                        echo "\n=== Container Health ==="                    docker stats --no-stream backend frontend mongodb                                        echo "\n=== Network Info ==="                    docker network inspect bridge | grep -A 5 "Containers" || true                '''            }        }                stage('5?? Smoke Test') {            steps {                echo '?? Running Full Smoke Tests...'                sh '''                    chmod +x smoke_test_full.sh                    ./smoke_test_full.sh | tee artifacts/dev-${BUILD_NUMBER}/smoke-results.txt                '''            }        }                stage('6?? Archive Artifacts') {            steps {                echo '?? Archiving Dev Build Artifacts...'                sh '''                    # Build Info                    cat > artifacts/dev-${BUILD_NUMBER}/build-info.txt << EOF---------------------------------------    DEV BUILD REPORT---------------------------------------Build Number:    ${BUILD_NUMBER}Build Version:   ${BUILD_VERSION}Branch:          ${GIT_BRANCH}Commit:          ${GIT_COMMIT}Build Date:      $(date)Build URL:       ${BUILD_URL}Container State: Running (Pre-built)---------------------------------------EOF                                        # Container Logs (dernières 200 lignes)                    echo "Capturing container logs..."                    docker logs backend --tail 200 > artifacts/dev-${BUILD_NUMBER}/backend.log 2>&1 || true                    docker logs frontend --tail 200 > artifacts/dev-${BUILD_NUMBER}/frontend.log 2>&1 || true                    docker logs mongodb --tail 200 > artifacts/dev-${BUILD_NUMBER}/mongodb.log 2>&1 || true                                        # Container Info                    docker inspect backend > artifacts/dev-${BUILD_NUMBER}/backend-inspect.json || true                    docker inspect frontend > artifacts/dev-${BUILD_NUMBER}/frontend-inspect.json || true                    docker inspect mongodb > artifacts/dev-${BUILD_NUMBER}/mongodb-inspect.json || true                                        # Create archive                    cd artifacts                    tar -czf dev-${BUILD_NUMBER}-report.tar.gz dev-${BUILD_NUMBER}/                    echo "? Archive created: dev-${BUILD_NUMBER}-report.tar.gz"                '''                archiveArtifacts artifacts: 'artifacts/dev-*/**/*', allowEmptyArchive: true                archiveArtifacts artifacts: 'artifacts/*.tar.gz', allowEmptyArchive: true            }        }                stage('7?? Cleanup') {            steps {                echo '?? Cleanup...'                sh '''                    echo "Containers remain running"                    # Clean old archives (keep last 5)                    ls -t artifacts/*.tar.gz 2>/dev/null | tail -n +6 | xargs rm -f || true                '''            }        }    }        post {        success {            echo '? -----------------------------------'            echo '?   DEV BUILD PASSED'            echo '? -----------------------------------'            echo "?? Build ${BUILD_VERSION} completed!"        }        failure {            echo '? -----------------------------------'            echo '?   DEV BUILD FAILED'            echo '? -----------------------------------'        }    }}