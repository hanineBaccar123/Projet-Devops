pipeline {    agent any    triggers {        pollSCM('* * * * *')  // ou utiliser webhook Git pour push    }    stages {        stage('Checkout') {            steps {                checkout scm            }        }        stage('Setup') {            steps {                sh 'docker --version'                sh 'docker-compose --version'            }        }        stage('Build') {            steps {                sh 'docker-compose build'            }        }        stage('Run (Docker)') {            steps {                sh 'docker-compose up -d'            }        }        stage('Smoke Test') {            steps {                parallel(                    "Backend": {                        script {                            def code = sh(script: 'curl -s -o /dev/null -w "%{http_code}" http://localhost:5001', returnStdout: true).trim()                            if(code != '200') { error "Backend smoke test failed!" }                        }                    },                    "Frontend": {                        script {                            def code = sh(script: 'curl -s -o /dev/null -w "%{http_code}" http://localhost:5371', returnStdout: true).trim()                            if(code != '200') { error "Frontend smoke test failed!" }                        }                    }                )            }        }        stage('Archive Artifacts') {            steps {                archiveArtifacts artifacts: '**/build/**, **/logs/**', allowEmptyArchive: true            }        }        stage('Cleanup') {            steps {                sh 'docker-compose down'            }        }    }}