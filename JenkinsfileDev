pipeline {    agent any    environment {        BACKEND_PORT = "5001"        FRONTEND_PORT = "5371"        ARTIFACTS_DIR = "artifacts"    }    parameters {        booleanParam(name: 'IS_PR', defaultValue: false, description: 'Pipeline PR')        booleanParam(name: 'IS_TAG', defaultValue: false, description: 'Build versionné sur tag')    }    stages {        stage('Checkout') {            steps {                echo "?? Checkout code source..."                checkout scm            }        }        stage('Setup') {            steps {                echo "?? Installation des outils..."                sh 'docker --version || echo "Docker non trouvé"'                sh 'docker-compose --version || echo "docker-compose non trouvé"'                sh 'chmod +x smoke_test_full.sh || echo "Pas d\'exécutable à changer"'                sh 'mkdir -p ${ARTIFACTS_DIR}'            }        }        stage('Build') {            steps {                echo "??? Build Docker images..."                sh 'docker build -t frontend-dev -f DockerfileFrontend .'                sh 'docker build -t backend-dev -f DockerfileBackend .'            }        }        stage('Run Docker') {            steps {                echo "?? Lancement containers pour test..."                sh """                    docker-compose up -d                    sleep 5                """                echo "? Containers démarrés (backend:${BACKEND_PORT}, frontend:${FRONTEND_PORT})"            }        }        stage('Smoke Test') {            steps {                echo "?? Exécution smoke test..."                sh './smoke_test_full.sh || echo "Smoke test échoué"'            }        }        stage('Archive Artifacts') {            steps {                echo "?? Archivage des logs et rapports..."                archiveArtifacts artifacts: "${ARTIFACTS_DIR}/**", allowEmptyArchive: true            }        }    }    post {        always {            echo "?? Cleanup éventuel..."            sh 'docker-compose down || echo "Pas de containers à arrêter"'        }        success {            echo "? Pipeline terminé avec succès"        }        failure {            echo "? Pipeline échoué, vérifier les logs"        }    }}