pipeline {  agent any  triggers {    pollSCM('* * * * *')   // toutes les minutes  }  environment {    ARTIFACTS_DIR = "artifacts"    FRONTEND_PORT = "5371"    BACKEND_PORT  = "5001"  }  stages {    /* ------------------- CHECKOUT --------------------- */    stage('Checkout') {      steps {        echo "Checkout du code source"        checkout scm      }    }    /* ------------------- SETUP --------------------- */    stage('Setup') {      steps {        echo "Setup: vérifier outils"        bat 'node -v || echo node not found'        bat 'docker --version'        bat 'docker-compose --version || echo docker-compose not found'        bat "if not exist ${env.ARTIFACTS_DIR} mkdir ${env.ARTIFACTS_DIR}"      }    }    /* ------------------- CLEANUP AVANT BUILD --------------------- */    stage('Pre-Cleanup') {      steps {        echo "Arrêt des conteneurs existants"        bat "docker-compose -f docker-compose.yml down > ${env.ARTIFACTS_DIR}\\docker-pre-down-${env.BUILD_ID}.log 2>&1 || echo ignore"      }    }    /* ------------------- BUILD (PARALLEL) --------------------- */    stage('Build') {      parallel {        /* ------------ FRONTEND ------------ */        stage('Build - frontend (node 20)') {          steps {            echo 'Build image FRONTEND'            bat """              docker build --build-arg NODE_VERSION=20 -t myapp-frontend:${env.BUILD_ID} -t myapp-frontend:latest -f Dockerfilefrontend . ^              > ${env.ARTIFACTS_DIR}\\frontend-build-${env.BUILD_ID}.log 2>&1            """            archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/frontend-build-${env.BUILD_ID}.log", fingerprint: true          }        }        /* ------------ BACKEND ------------ */        stage('Build - backend (node 20)') {          steps {            echo 'Build image BACKEND'            bat """              docker build --build-arg NODE_VERSION=20 -t myapp-backend:${env.BUILD_ID} -t myapp-backend:latest -f Dockerfilebackend . ^              > ${env.ARTIFACTS_DIR}\\backend-build-${env.BUILD_ID}.log 2>&1            """            archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/backend-build-${env.BUILD_ID}.log", fingerprint: true          }        }      } // fin parallel    }    /* ------------------- RUN (DOCKER COMPOSE) --------------------- */    stage('Run (Docker)') {      steps {        echo "Run docker-compose"        bat "docker-compose -f docker-compose.yml up -d > ${env.ARTIFACTS_DIR}\\docker-up-${env.BUILD_ID}.log 2>&1"        archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/docker-up-${env.BUILD_ID}.log"        echo "Attente du démarrage des services..."        bat 'TIMEOUT /T 10 /NOBREAK'      }    }    /* ------------------- SMOKE TEST --------------------- */    stage('Smoke Test') {      steps {        echo "Smoke Test API /health"        bat """          node smoke/smoke.js http://localhost:${env.BACKEND_PORT}/health ^          > ${env.ARTIFACTS_DIR}\\smoke-${env.BUILD_ID}.txt 2>&1        """        archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/smoke-${env.BUILD_ID}.txt"        bat "findstr /C:\"SMOKE PASSED\" ${env.ARTIFACTS_DIR}\\smoke-${env.BUILD_ID}.txt"      }      post {        failure {          echo "Smoke Test FAILED - Affichage des logs Docker"          bat "docker-compose logs > ${env.ARTIFACTS_DIR}\\docker-logs-${env.BUILD_ID}.txt 2>&1"          archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/docker-logs-${env.BUILD_ID}.txt"        }      }    }    /* ------------------- ARCHIVE --------------------- */    stage('Archive Artifacts') {      steps {        echo "Archivage complet"        archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/**", fingerprint: true      }    }    /* ------------------- CLEANUP OPTIONNEL --------------------- */    stage('Post-Cleanup') {      when {        expression { params.CLEANUP_AFTER_BUILD == true }      }      steps {        echo "Nettoyage Docker (optionnel)"        bat "docker-compose -f docker-compose.yml down > ${env.ARTIFACTS_DIR}\\docker-down-${env.BUILD_ID}.log 2>&1 || echo ignore"        bat "docker rmi myapp-backend:${env.BUILD_ID} myapp-frontend:${env.BUILD_ID} || echo ignore"        archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/docker-down-${env.BUILD_ID}.log"      }    }  } // end stages    parameters {    booleanParam(name: 'CLEANUP_AFTER_BUILD', defaultValue: false, description: 'Arrêter les conteneurs après le build ?')  }    post {    success {      echo "? Pipeline DEV SUCCEEDED"      echo "Frontend: http://localhost:${env.FRONTEND_PORT}"      echo "Backend: http://localhost:${env.BACKEND_PORT}"    }    failure {      echo "? Pipeline DEV FAILED"      bat "docker ps -a"      bat "docker-compose logs --tail=50"    }    always {      echo "Pipeline terminé - Build #${env.BUILD_ID}"    }  }}