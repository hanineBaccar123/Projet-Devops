pipeline {    agent any    environment {        BACKEND_PORT = "5001"        FRONTEND_PORT = "5371"        ARTIFACTS_DIR = "artifacts"    }    stages {        stage('Checkout') {            steps {                checkout scm            }        }        stage('Build Docker Images') {            steps {                echo 'Building Docker images...'                bat 'docker-compose build'            }        }        stage('Start Containers') {            steps {                echo 'Starting MongoDB...'                bat 'docker-compose up -d mongodb'  // Nom correct du service                echo 'Waiting for MongoDB to be ready...'                bat 'timeout /t 10'                echo 'Starting Backend and Frontend...'                bat 'docker-compose up -d backend frontend'                echo 'Waiting for Backend to be ready...'                bat """                powershell -Command "                for (\$i=0; \$i -lt 20; \$i++) {                    try {                        \$r = Invoke-WebRequest -UseBasicParsing http://localhost:${BACKEND_PORT}/health                        if (\$r.Content -match 'OK') {                            Write-Host 'Backend is up!'                            exit 0                        }                    } catch {}                    Write-Host 'Waiting for backend...'                    Start-Sleep -Seconds 3                }                Write-Host 'Backend did not start in time'                exit 1                "                """            }        }        stage('Run Smoke Tests') {            steps {                echo 'Running smoke tests...'                bat 'smoke_test_full.bat'  // Script Windows            }        }    }    post {        always {            echo 'Cleaning up Docker containers...'            bat 'docker-compose down'        }        success {            echo 'Pipeline succeeded ?'        }        failure {            echo 'Pipeline failed ?'        }    }}