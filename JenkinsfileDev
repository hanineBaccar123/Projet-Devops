pipeline {  agent any  // paramètres (doivent être avant les stages)  parameters {    booleanParam(name: 'CLEANUP_AFTER_BUILD', defaultValue: false, description: 'Arrêter les conteneurs après le build ?')  }  triggers {    pollSCM('* * * * *')   // toutes les minutes  }  environment {    ARTIFACTS_DIR = "artifacts"    FRONTEND_PORT = "5371"    BACKEND_PORT  = "5001"  }  stages {    /* ------------------- CHECKOUT --------------------- */    stage('Checkout') {      steps {        echo "Checkout du code source"        checkout scm      }    }    /* ------------------- SETUP --------------------- */    stage('Setup') {      steps {        echo "Setup: vérifier outils"        bat 'node -v || echo node not found'        bat 'docker --version'        bat 'docker-compose --version || echo docker-compose not found'        // créer artifacts (important)        bat "if not exist ${env.ARTIFACTS_DIR} mkdir ${env.ARTIFACTS_DIR}"      }    }    /* ------------------- CLEANUP AVANT BUILD --------------------- */    stage('Pre-Cleanup') {      steps {        echo "Stop & suppression des containers possibles (pour éviter les conflits de nom)"        // suppression silencieuse si le container n'existe pas        bat '''          docker rm -f mongodb 2>NUL || echo "mongodb non existant"          docker rm -f backend 2>NUL || echo "backend non existant"          docker rm -f frontend 2>NUL || echo "frontend non existant"          docker-compose -f docker-compose.yml down > ${ARTIFACTS_DIR}\\docker-pre-down-${BUILD_ID}.log 2>&1 || echo "docker-compose down non critique"        '''        archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/docker-pre-down-${env.BUILD_ID}.log", allowEmptyArchive: true      }    }    /* ------------------- BUILD (PARALLEL) --------------------- */    stage('Build') {      parallel {        /* ------------ FRONTEND ------------ */        stage('Build - frontend (node 20)') {          steps {            echo 'Build image FRONTEND'            script {              bat "if not exist ${env.ARTIFACTS_DIR} mkdir ${env.ARTIFACTS_DIR}"              def status = bat(returnStatus: true, script: """                docker build --build-arg NODE_VERSION=20 -t myapp-frontend:${env.BUILD_ID} -t myapp-frontend:latest -f Dockerfilefrontend . ^                > ${env.ARTIFACTS_DIR}\\\\frontend-build-${env.BUILD_ID}.log 2>&1              """)              archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/frontend-build-${env.BUILD_ID}.log", fingerprint: true, allowEmptyArchive: false              if (status != 0) {                error("Frontend build failed - voir ${env.ARTIFACTS_DIR}/frontend-build-${env.BUILD_ID}.log")              }            }          }        }        /* ------------ BACKEND ------------ */        stage('Build - backend (node 20)') {          steps {            echo 'Build image BACKEND'            script {              bat "if not exist ${env.ARTIFACTS_DIR} mkdir ${env.ARTIFACTS_DIR}"              def status = bat(returnStatus: true, script: """                docker build --build-arg NODE_VERSION=20 -t myapp-backend:${env.BUILD_ID} -t myapp-backend:latest -f Dockerfilebackend . ^                > ${env.ARTIFACTS_DIR}\\\\backend-build-${env.BUILD_ID}.log 2>&1              """)              archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/backend-build-${env.BUILD_ID}.log", fingerprint: true, allowEmptyArchive: false              if (status != 0) {                error("Backend build failed - voir ${env.ARTIFACTS_DIR}/backend-build-${env.BUILD_ID}.log")              }            }          }        }      } // fin parallel    }    /* ------------------- RUN (DOCKER COMPOSE) --------------------- */    stage('Run (Docker)') {      steps {        echo "Run docker-compose (up -d)"        script {          def status = bat(returnStatus: true, script: """            docker-compose -f docker-compose.yml up -d > ${env.ARTIFACTS_DIR}\\\\docker-up-${env.BUILD_ID}.log 2>&1          """)          archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/docker-up-${env.BUILD_ID}.log", allowEmptyArchive: true          if (status != 0) {            echo "AVERTISSEMENT: docker-compose a retourné le code ${status} (voir log ci-dessus)"            // vérifier si les containers attendus tournent malgré tout            def running = bat(returnStatus: true, script: 'docker ps | findstr "frontend backend mongodb"')            if (running != 0) {              error("Les conteneurs n'ont pas démarré correctement (docker ps n'a pas trouvé frontend/backend/mongodb)")            } else {              echo "Les conteneurs sont démarrés malgré le code retour non-zéro"            }          } else {            echo "docker-compose up a retourné 0"          }        }        echo "Attente du démarrage des services..."        sleep 10      }    }    /* ------------------- SMOKE TEST --------------------- */    stage('Smoke Test') {      steps {        echo "Smoke Test API /health (Windows-friendly)"        script {          // utilise le script Node (smoke/smoke.js) — compatible Windows          def status = bat(returnStatus: true, script: """            node smoke/smoke.js http://localhost:${env.BACKEND_PORT}/health ^            > ${env.ARTIFACTS_DIR}\\\\smoke-${env.BUILD_ID}.txt 2>&1          """)          archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/smoke-${env.BUILD_ID}.txt", fingerprint: true, allowEmptyArchive: false          // vérifier le contenu du fichier (SMOKE PASSED)          def grepStatus = bat(returnStatus: true, script: "findstr /C:\"SMOKE PASSED\" ${env.ARTIFACTS_DIR}\\\\smoke-${env.BUILD_ID}.txt")          if (status != 0 || grepStatus != 0) {            error("Smoke test échoué - voir ${env.ARTIFACTS_DIR}/smoke-${env.BUILD_ID}.txt")          } else {            echo "SMOKE PASSED"          }        }      }      post {        failure {          echo "Smoke Test FAILED - Affichage des logs Docker"          bat "docker-compose logs > ${env.ARTIFACTS_DIR}\\\\docker-logs-${env.BUILD_ID}.txt 2>&1"          archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/docker-logs-${env.BUILD_ID}.txt", allowEmptyArchive: true          bat "type ${env.ARTIFACTS_DIR}\\\\smoke-${env.BUILD_ID}.txt"        }      }    }    /* ------------------- ARCHIVE --------------------- */    stage('Archive Artifacts') {      steps {        echo "Archivage complet"        archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/**", fingerprint: true, allowEmptyArchive: true      }    }    /* ------------------- CLEANUP OPTIONNEL --------------------- */    stage('Post-Cleanup') {      when {        expression { return params.CLEANUP_AFTER_BUILD == true }      }      steps {        echo "Nettoyage Docker (optionnel)"        script {          bat """            docker-compose -f docker-compose.yml down > ${env.ARTIFACTS_DIR}\\\\docker-down-${env.BUILD_ID}.log 2>&1 || echo "docker-compose down non critique"          """        }        // suppression des images créées pour ce build (silencieuse)        bat "docker rmi myapp-backend:${env.BUILD_ID} myapp-frontend:${env.BUILD_ID} || echo ignore"        archiveArtifacts artifacts: "${env.ARTIFACTS_DIR}/docker-down-${env.BUILD_ID}.log", allowEmptyArchive: true      }    }  } // end stages  post {    success {      echo "? Pipeline DEV SUCCEEDED"      echo "Frontend: http://localhost:${env.FRONTEND_PORT}"      echo "Backend: http://localhost:${env.BACKEND_PORT}"    }    failure {      echo "? Pipeline DEV FAILED"      bat "docker ps -a"      bat "docker-compose logs --tail=50"    }    always {      echo "Pipeline terminé - Build #${env.BUILD_ID}"    }  }}