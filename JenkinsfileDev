pipeline {    agent any    triggers {        pollSCM('* * * * *') // ou utiliser webhook Git pour push    }    environment {        BACKEND_URL = 'http://localhost:5001'        FRONTEND_URL = 'http://localhost:5371'        BRANCH_NAME = "${env.BRANCH_NAME ?: 'dev'}" // Nom de branche pour Docker multibranches    }    stages {        stage('Checkout') {            steps {                checkout scm            }        }        stage('Setup') {            steps {                echo "Vérification de Docker et Docker Compose..."                bat 'docker --version'                bat 'docker-compose --version'            }        }        stage('Build') {            steps {                echo "Construction des images Docker..."                bat "docker-compose build"            }        }        stage('Run (Docker)') {            steps {                echo "Arrêt et suppression des containers existants..."                bat "docker-compose down --remove-orphans"                echo "Démarrage des containers..."                bat "docker-compose up -d --force-recreate"            }        }        stage('Smoke Test') {            parallel {                stage('Backend') {                    steps {                        script {                            echo "Test du backend..."                            def code = bat(script: "curl -s -o NUL -w \"%{http_code}\" %BACKEND_URL%", returnStdout: true).trim()                            if (code != '200') {                                error "Backend smoke test failed!"                            }                        }                    }                }                stage('Frontend') {                    steps {                        script {                            echo "Test du frontend..."                            def code = bat(script: "curl -s -o NUL -w \"%{http_code}\" %FRONTEND_URL%", returnStdout: true).trim()                            if (code != '200') {                                error "Frontend smoke test failed!"                            }                        }                    }                }            }        }        stage('Archive Artifacts') {            steps {                echo "Archivage des artefacts..."                archiveArtifacts artifacts: '**/build/**, **/logs/**', allowEmptyArchive: true            }        }        stage('Cleanup') {            steps {                echo "Nettoyage des containers Docker..."                bat "docker-compose down --remove-orphans"            }        }    }    post {        failure {            echo "Le pipeline a échoué"            bat "docker-compose down --remove-orphans"        }        success {            echo "Pipeline terminé avec succès"        }    }}