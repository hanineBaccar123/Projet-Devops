pipeline {    agent any    environment {        BACKEND_PORT = "5001"        FRONTEND_PORT = "5371"        ARTIFACTS_DIR = "artifacts"    }    triggers {        pollSCM('* * * * *') // déclenchement automatique sur branche dev    }    stages {        stage('Checkout') {            steps {                echo "?? Checkout dev..."                checkout scm            }        }        stage('Setup') {            steps {                echo "?? Vérification des outils..."                bat 'docker --version || echo Docker non trouvé'                bat 'docker-compose --version || echo Docker Compose non trouvé'                bat 'if not exist "%ARTIFACTS_DIR%" mkdir "%ARTIFACTS_DIR%"'            }        }        stage('Build/Update Images') {            steps {                echo "?? Construction des images si nécessaire..."                // Construire uniquement si Dockerfile a changé                bat 'docker build -t backend-dev -f Dockerfilebackend . || echo Backend image déjà existante'                bat 'docker build -t frontend-dev -f Dockerfilefrontend . || echo Frontend image déjà existante'            }        }        stage('Run Containers') {            steps {                echo "?? Démarrage des containers (réutilisation existants)..."                // On ne supprime pas MongoDB pour ne pas perdre les données                bat 'docker-compose up -d backend frontend || echo Containers déjà en cours'                bat 'ping 127.0.0.1 -n 10 > nul' // attendre que les containers soient prêts            }        }        stage('Smoke Test') {            steps {                echo "?? Lancement du Smoke Test..."                // exécuter script Windows ou adapter .sh pour PowerShell                bat 'powershell -Command "./smoke_test_full.ps1" || exit 1'            }        }        stage('Archive Artifacts') {            steps {                echo "?? Archivage des logs et rapports..."                archiveArtifacts artifacts: "%ARTIFACTS_DIR%\\**", allowEmptyArchive: true            }        }    }    post {        always {            echo "?? Nettoyage des containers Frontend et Backend..."            bat 'docker-compose stop backend frontend || echo Pas de containers à arrêter'        }        success {            echo "? Pipeline dev réussi"        }        failure {            echo "? Pipeline dev échoué"        }    }}