pipeline {    agent any    triggers {        // Déclenche automatiquement le pipeline sur push sur dev        pollSCM('* * * * *')    }    environment {        // Définit le répertoire où les artefacts seront stockés        ARTIFACTS_DIR = 'artifacts'    }    stages {        stage('Checkout') {            steps {                git branch: 'dev', url: 'https://github.com/hanineBaccar123/Projet-Devops.git'            }        }        stage('Install Frontend') {            steps {                dir('FrontendElearning') {                    bat 'npm install'                }            }        }        stage('Install Backend') {            steps {                dir('BackendElearning') {                    bat 'npm install'                }            }        }        stage('Run Smoke Tests') {            steps {                bat 'smoketest.sh'                bat 'smoketestbackend.sh'                bat 'smoke_test_full.sh'            }        }        stage('Build Complet') {            when {                branch 'dev' // uniquement si push sur dev            }            steps {                echo 'Building Frontend...'                dir('FrontendElearning') {                    bat 'npm run build'                }                echo 'Building Backend...'                dir('BackendElearning') {                    bat 'npm run build'                }                echo 'Build complet terminé ?'            }        }        stage('Versioning & Archive') {            when {                // Ne s'exécute que si on build à partir d'un tag                buildingTag()            }            steps {                script {                    // Récupère le nom du tag (ex: v1.0.0)                    def version = env.GIT_TAG ?: 'v0.0.0'                    echo "Version du build : ${version}"                    // Crée un dossier pour les artefacts si non existant                    bat "mkdir ${ARTIFACTS_DIR}"                    // Copie les builds frontend et backend dans le dossier artefacts                    bat "xcopy /s /i FrontendElearning\\build ${ARTIFACTS_DIR}\\frontend_${version}"                    bat "xcopy /s /i BackendElearning\\build ${ARTIFACTS_DIR}\\backend_${version}"                }                // Archive les artefacts dans Jenkins                archiveArtifacts artifacts: "${ARTIFACTS_DIR}/**", fingerprint: true            }        }    }}