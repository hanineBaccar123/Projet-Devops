pipeline {    agent any    triggers {        // Trigger on any push        pollSCM('* * * * *')    }    environment {        ARTIFACTS_DIR = 'artifacts'    }    stages {        /* -------------------- CHECKOUT -------------------- */        stage('Checkout') {            steps {                checkout scm                script {                    echo "Branch: ${env.GIT_BRANCH}"                    echo "Tag: ${env.GIT_TAG}"                }            }        }        /* -------------------- SETUP -------------------- */        stage('Setup Frontend & Backend') {            steps {                echo "Installing dependencies..."                dir('FrontendElearning') {                    bat 'npm install'                }                dir('BackendElearning') {                    bat 'npm install'                }            }        }        /* -------------------- BUILD -------------------- */        stage('Build App') {            when {                // Run full build ONLY on dev OR when building a tag                expression {                    return env.GIT_BRANCH == "origin/dev" || env.GIT_TAG =~ /^v[0-9]+\.[0-9]+\.[0-9]+$/                }            }            steps {                echo 'Building Frontend...'                dir('FrontendElearning') {                    bat 'npm run build'                }                echo 'Building Backend...'                dir('BackendElearning') {                    bat 'npm run build'                }            }        }        /* -------------------- RUN DOCKER -------------------- */        stage('Run Docker') {            steps {                echo "Running Docker containers..."                bat 'docker-compose up -d --build'            }        }        /* -------------------- SMOKE TEST -------------------- */        stage('Smoke Test') {            steps {                echo "Running Smoke Tests..."                bat 'smoketest.sh'                bat 'smoketestbackend.sh'                bat 'smoke_test_full.sh'            }        }        /* -------------------- VERSIONING & ARCHIVE -------------------- */        stage('Versioned Archive') {            when {                expression {                    // TRUE only if TAG matches vX.Y.Z                    return env.GIT_TAG =~ /^v[0-9]+\.[0-9]+\.[0-9]+$/                }            }            steps {                script {                    echo "Tag detected ? Version Build"                    // Clean + recreate artifacts folder                    bat "if exist ${ARTIFACTS_DIR} rmdir /S /Q ${ARTIFACTS_DIR}"                    bat "mkdir ${ARTIFACTS_DIR}"                    // Use tag name                    def version = env.GIT_TAG                    echo "Version: ${version}"                    // Copy builds                    bat "xcopy /E /I FrontendElearning\\build ${ARTIFACTS_DIR}\\frontend_${version}"                    bat "xcopy /E /I BackendElearning\\build ${ARTIFACTS_DIR}\\backend_${version}"                }                archiveArtifacts artifacts: "${ARTIFACTS_DIR}/**", fingerprint: true            }        }        /* -------------------- CLEANUP -------------------- */        stage('Cleanup') {            steps {                echo "Cleaning Docker containers..."                bat 'docker-compose down'            }        }    }}