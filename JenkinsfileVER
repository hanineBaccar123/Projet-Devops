pipeline {    agent any    triggers {        // Vérifie chaque minute si un nouveau TAG est poussé        pollSCM('* * * * *')    }    environment {        REGISTRY = "haninebaccar"        FRONT_IMAGE = "elearning-frontend"        BACK_IMAGE = "elearning-backend"    }    options {        skipDefaultCheckout(true)    }    stages {        stage('Checkout') {            steps {                echo "?? Récupération du code depuis un TAG..."                checkout([                    $class: 'GitSCM',                    branches: [[name: "refs/tags/*"]],                    userRemoteConfigs: [[                        url: 'https://github.com/hanineBaccar123/Projet-Devops',                        credentialsId: 'dockerhub-creds'                    ]]                ])            }        }        stage('Validation du Tag') {            steps {                script {                    def tag = env.BRANCH_NAME ?: ""                    if (!tag.startsWith("v")) {                        error("? Ce pipeline ne tourne QUE pour les tags versionnés (vX.Y.Z) — Tag actuel : ${tag}")                    }                    echo "?? Build versionné détecté : ${tag}"                    env.VERSION = tag                }            }        }        stage('Build des images Docker') {            steps {                echo "?? Build des images Docker frontend + backend..."                bat """                docker build -t %REGISTRY%/%FRONT_IMAGE%:%VERSION% -f Dockerfilefrontend .                docker build -t %REGISTRY%/%BACK_IMAGE%:%VERSION% -f Dockerfilebackend .                """            }        }        stage('Push Registry') {            steps {                echo "?? Push des images vers Docker Hub..."                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'USER', passwordVariable: 'PASS')]) {                    bat """                    docker login -u %USER% -p %PASS%                    docker push %REGISTRY%/%FRONT_IMAGE%:%VERSION%                    docker push %REGISTRY%/%BACK_IMAGE%:%VERSION%                    """                }            }        }        stage('Run Containers (docker-compose)') {            steps {                echo "?? Lancement via docker-compose..."                bat """                docker-compose -f "%WORKSPACE%/docker-compose.yml" down || exit 0                docker-compose -f "%WORKSPACE%/docker-compose.yml" up -d                """            }        }        stage('Smoke Tests') {            steps {                echo "?? Exécution des smoke tests..."                bat "smoke_test_full.bat"            }        }        stage('Archive des artefacts') {            steps {                echo "?? Archivage des résultats..."                archiveArtifacts artifacts: 'artifacts/**/*', fingerprint: true            }        }    }    post {        always {            echo "?? Cleanup containers..."            bat "docker-compose -f \"%WORKSPACE%/docker-compose.yml\" down || exit 0"        }        success {            echo "? Pipeline versionné réussi ! ??"        }        failure {            echo "? Pipeline versionné en échec !"        }    }}