pipeline {    agent any    // vérifie le dépôt chaque minute pour détecter un nouveau tag vX.Y.Z    triggers {        pollSCM('* * * * *')    }    options {        // on fera checkout manuellement        skipDefaultCheckout(true)        // augmenter timeout en cas de pulls d'images volumineuses        timeout(time: 60, unit: 'MINUTES')    }    environment {        REGISTRY = "haninebaccar"              // change si besoin        FRONT_IMAGE = "elearning-frontend"        BACK_IMAGE = "elearning-backend"        // workspace est disponible via %WORKSPACE% en windows bat    }    stages {        stage('Checkout') {            steps {                echo "?? Récupération du code (refs/tags/*)..."                // Checkout des tags (on récupère le working tree complet)                checkout([                    $class: 'GitSCM',                    branches: [[name: "refs/tags/*"]],                    userRemoteConfigs: [[                        url: 'https://github.com/hanineBaccar123/Projet-Devops',                        credentialsId: 'dockerhub-creds'                    ]]                ])            }        }        stage('Validate Tag') {            steps {                script {                    // Récupère le tag courant dans le workspace (via git)                    def tag = bat(script: 'git describe --tags --exact-match || echo ', returnStdout: true).trim()                    echo "?? Tag trouvé : '${tag}'"                    if (!tag || !tag.matches(/^v\\d+\\.\\d+\\.\\d+$/)) {                        error("? Ce pipeline ne tourne QUE pour les tags versionnés (vX.Y.Z) — Tag actuel : ${tag}")                    }                    env.VERSION = tag                    echo "? Version utilisée : ${env.VERSION}"                }            }        }        stage('Install Dependencies (frontend + backend)') {            steps {                script {                    // Installe dependencies dans frontend et backend via container node:20                    // Si dossier frontend/backend n'existe pas, on skip et log                    def frontendDir = "${env.WORKSPACE}\\frontend"                    def backendDir  = "${env.WORKSPACE}\\backend"                    // FRONTEND                    if (fileExists(frontendDir)) {                        echo "?? Installing frontend deps (node:20)..."                        // utilise -w /app/frontend et monte uniquement le dossier concerné                        def cmdFront = "\"docker run --rm -v \\\"${frontendDir}:/app\\\" -w /app node:20 npm ci --omit=dev\""                        bat(script: cmdFront)                    } else {                        echo "?? frontend folder not found at ${frontendDir} — skipping frontend npm install"                    }                    // BACKEND (if present and has package.json)                    if (fileExists(backendDir)) {                        echo "?? Installing backend deps (node:20)..."                        def cmdBack = "\"docker run --rm -v \\\"${backendDir}:/app\\\" -w /app node:20 npm ci --omit=dev\""                        bat(script: cmdBack)                    } else {                        echo "?? backend folder not found at ${backendDir} — skipping backend npm install"                    }                }            }        }        stage('Build (frontend)') {            steps {                script {                    def frontendDir = "${env.WORKSPACE}\\frontend"                    if (fileExists(frontendDir)) {                        echo "?? Build frontend (vite) with Node 20..."                        // build du frontend                        bat "\"docker run --rm -v \\\"${frontendDir}:/app\\\" -w /app node:20 npm run build\""                        // copie des assets build dans workspace/build-frontend-%VERSION% pour archivage                        bat "if exist \"${frontendDir}\\\\dist\" ( mkdir -p build && xcopy /E /I \"${frontendDir}\\\\dist\" build\\\\frontend-${env.VERSION} ) else ( echo Frontend build output not found )"                    } else {                        echo "?? frontend folder absent — skipping frontend build"                    }                }            }        }        stage('Build Docker Images') {            steps {                script {                    // On suppose que les Dockerfile sont à la racine:                    // Dockerfilefrontend et Dockerfilebackend                    if (fileExists("${env.WORKSPACE}\\Dockerfilefrontend") && fileExists("${env.WORKSPACE}\\Dockerfilebackend")) {                        echo "?? Build images: ${REGISTRY}/${FRONT_IMAGE}:${VERSION} & ${REGISTRY}/${BACK_IMAGE}:${VERSION}"                        bat """                            docker build -t %REGISTRY%/%FRONT_IMAGE%:%VERSION% -f Dockerfilefrontend .                            docker build -t %REGISTRY%/%BACK_IMAGE%:%VERSION% -f Dockerfilebackend .                        """                    } else {                        error("? Dockerfilefrontend and/or Dockerfilebackend not found in workspace root.")                    }                }            }        }        stage('Push to Registry') {            steps {                echo "?? Push images to Docker Hub"                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {                    bat """                        docker login -u %DOCKER_USER% -p %DOCKER_PASS%                        docker push %REGISTRY%/%FRONT_IMAGE%:%VERSION%                        docker push %REGISTRY%/%BACK_IMAGE%:%VERSION%                    """                }            }        }        stage('Run Containers (docker-compose)') {            steps {                script {                    def dcFile = "${env.WORKSPACE}\\docker-compose.yml"                    if (!fileExists(dcFile)) {                        error("? docker-compose.yml not found at ${dcFile}. Place a compose file referencing the versioned images.")                    }                    echo "?? docker-compose up -d"                    // utilise le chemin Windows avec -f                    bat "docker-compose -f \"${dcFile}\" down || exit 0"                    bat "docker-compose -f \"${dcFile}\" up -d"                    // attente courte pour que services montent                    bat "timeout /t 5"                }            }        }        stage('Smoke Tests') {            steps {                echo "?? Lancement des smoke tests (Windows .bat)..."                // Assure-toi que smoke_test_full.bat est à la racine du repo ou adapte le chemin                script {                    def smokeCmd = "smoke_test_full.bat"                    if (!fileExists("${env.WORKSPACE}\\${smokeCmd}")) {                        error("? ${smokeCmd} introuvable dans workspace.")                    }                    // exécute et capture code de retour                    def rc = bat(script: smokeCmd, returnStatus: true)                    if (rc != 0) {                        error("? Smoke tests failed (exit ${rc})")                    } else {                        echo "? Smoke tests passed"                    }                }            }        }        stage('Archive Artifacts') {            steps {                echo "?? Archivage des artefacts (build logs / smoke results / builds)..."                // exemple : on archive dossier build et artifacts                // Assure-toi que ton pipeline écrit dans artifacts\...                archiveArtifacts artifacts: 'build/**, artifacts/**', fingerprint: true, allowEmptyArchive: false            }        }    }    post {        always {            echo "?? Cleanup: docker-compose down (si présent)"            // tente de down même si compose absent : on ignore l'erreur finale            bat script: "if exist \"%WORKSPACE%\\\\docker-compose.yml\" ( docker-compose -f \"%WORKSPACE%\\\\docker-compose.yml\" down || exit 0 ) else ( echo no docker-compose.yml to run down )", returnStatus: true        }        success {            echo "? Pipeline versionné réussi pour ${env.VERSION}"        }        failure {            echo "? Pipeline versionné échoué pour ${env.VERSION}"        }    }}