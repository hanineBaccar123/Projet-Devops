pipeline {    agent any    environment {        VERSION = "v1.0.0"    }    stages {        stage('Checkout') {            steps {                echo "?? Récupération du code version ${VERSION}..."                checkout scm            }        }        stage('Setup') {            steps {                echo "?? Installation des dépendances..."                bat """                docker run --rm ^                    -v "%WORKSPACE%":/app ^                    -w /app node:18 ^                    sh -c "npm install --omit=dev"                """            }        }        stage('Build') {            steps {                echo "??? Build du projet..."                bat """                docker run --rm ^                    -v "%WORKSPACE%":/app ^                    -w /app node:18 ^                    sh -c "npm run build"                """            }        }        stage('Run Docker') {            steps {                echo "?? Construction de l'image Docker..."                bat """                docker build -t projet-devops:${VERSION} .                """            }        }        stage('Smoke Test') {            steps {                echo "?? Test rapide du conteneur..."                bat """                docker run --rm projet-devops:${VERSION} node -v                """            }        }        stage('Archive Artifacts') {            steps {                echo "?? Archivage..."                archiveArtifacts artifacts: "dist/**", fingerprint: true            }        }    }    post {        success {            echo "?? Release ${VERSION} réussie !"        }        failure {            echo "? Échec de la release ${VERSION}"        }    }}