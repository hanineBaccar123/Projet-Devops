// Jenkinsfile.releasepipeline {    agent any    tools {        nodejs 'NodeJS-18'    }    environment {        APP_NAME = 'mon-app-react'        VERSION = "${env.TAG_NAME}"        DOCKER_IMAGE = "${APP_NAME}:${VERSION}"    }    stages {        stage('Checkout') {            steps {                echo "???? Récupération du code pour la version ${VERSION}......"                checkout scm            }        }        stage('Setup') {            steps {                echo '?? Installation des dépendances......'                // Installer uniquement les dépendances de production pour la release                sh '''                node --version                npm --version                npm ci --production                '''            }        }        stage('Build') {            steps {                echo "???? Build de la version ${VERSION}......"                sh '''                npm run build                echo "${VERSION}" >> build/version.txt                '''            }        }        stage('Run Docker') {            steps {                echo '???? Construction et lancement du conteneur......'                sh '''                docker build --tag ${DOCKER_IMAGE} .                docker tag ${DOCKER_IMAGE} ${APP_NAME}:latest                docker run --detach --name ${APP_NAME}-release --publish 30003:80 ${DOCKER_IMAGE}                sleep 5                '''            }        }        stage('Smoke Test') {            steps {                echo '???? Exécution des smoke tests......'                script {                    // Utilise curl pour tester le conteneur sur le port 30003                    def result = sh(                        script: 'curl --fail http://localhost:30003 || exit 1',                        returnStatus: true                     )                    if (result == 0) {                        echo '?? SMOKE TEST PASSED'                    } else {                        error '?? SMOKE TEST FAILED'                    }                }            }        }        stage('Archive Artifacts') {            steps {                echo '???? Archivage des artefacts de release......'                sh '''                mkdir -p artifacts/release-${VERSION}                # Informations de build                echo "Release Version: ${VERSION}" >> artifacts/release-${VERSION}/release-info.txt                echo "Status: SUCCESS" >> artifacts/release-${VERSION}/release-info.txt                echo "Date: $(date)" >> artifacts/release-${VERSION}/release-info.txt                tar -czf artifacts/release-${VERSION}/build-${VERSION}.tar.gz build/                '''                archiveArtifacts artifacts: 'artifacts/**/*', allowEmptyArchive: false            }        }        stage('Cleanup') {            steps {                echo '???? Nettoyage......'                sh '''                docker stop ${APP_NAME}-release || true                docker rm ${APP_NAME}-release || true                '''            }        }    }    post {        always {            echo '???? Pipeline de release terminé'        }        success {            echo "?? Release ${VERSION} réussie"            // Ici, vous ajouteriez l'étape de déploiement vers un environnement de production        }        failure {            echo "?? Release ${VERSION} échouée"        }    }}