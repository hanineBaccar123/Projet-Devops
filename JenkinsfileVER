pipeline {    agent any    // Définition des variables d'environnement    environment {        // Récupère le nom du tag (ex: v1.0.0). Si pas de tag, met 'latest'        VERSION = "${env.TAG_NAME ?: 'latest'}"                // Noms de vos images        IMAGE_BACKEND = "devops-backend"        IMAGE_FRONTEND = "devops-frontend"    }    stages {        // 1. Checkout : Récupération du code source        stage('Checkout') {            steps {                script {                    echo "Déploiement de la version : ${env.VERSION}"                }                checkout scm            }        }        // 2. Setup : Préparation de l'environnement        stage('Setup') {            steps {                script {                    echo "Nettoyage de l'environnement Docker..."                    // Supprime les conteneurs existants pour partir sur du propre                    sh 'docker-compose down --remove-orphans || true'                    // Rend les scripts de test exécutables                    sh 'chmod +x smoke_test_full.sh'                }            }        }        // 3. Build Parallel : Construction simultanée du Back et du Front        stage('Build Parallel') {            parallel {                stage('Build Backend') {                    steps {                        script {                            echo "Construction Backend version ${env.VERSION}..."                            // Construit l'image et la tague avec la version                            sh "docker build -f Dockerfilebackend -t ${IMAGE_BACKEND}:${VERSION} ."                        }                    }                }                stage('Build Frontend') {                    steps {                        script {                            echo "Construction Frontend version ${env.VERSION}..."                            // Construit l'image et la tague avec la version                            sh "docker build -f Dockerfilefrontend -t ${IMAGE_FRONTEND}:${VERSION} ."                        }                    }                }            }        }        // 4. Run (Docker) : Lancement via Docker Compose        stage('Run (Docker)') {            steps {                script {                    echo "Démarrage de la stack avec la version ${env.VERSION}..."                    // On passe la variable VERSION au docker-compose pour qu'il utilise les images créées juste avant                    sh "export VERSION=${VERSION} && docker-compose up -d"                                        echo "Attente de la disponibilité des services (15s)..."                    sleep 15                }            }        }        // 5. Smoke Test : Vérification que tout fonctionne        stage('Smoke Test') {            steps {                script {                    echo "Exécution des Smoke Tests..."                    // Exécute le script bash visible dans votre capture                    // Si le script retourne exit 0 -> Passed, sinon -> Failed                    sh "./smoke_test_full.sh"                }            }        }        // 6. Archive Artifacts : Sauvegarde des preuves        stage('Archive Artifacts') {            steps {                script {                    echo "Récupération des logs..."                    // Capture des logs des conteneurs                    sh "docker-compose logs backend > backend.log"                    sh "docker-compose logs frontend > frontend.log"                    sh "docker-compose logs mongodb > mongodb.log"                                        // Archivage dans Jenkins (logs et scripts utilisés)                    archiveArtifacts artifacts: '*.log, *.sh', allowEmptyArchive: true                }            }        }    }    // Stage Cleanup : Nettoyage après exécution (Recommandé)    post {        always {            script {                echo "Nettoyage final..."                sh "docker-compose down"                // Optionnel : Supprimer les images pour économiser de la place                // sh "docker rmi ${IMAGE_BACKEND}:${VERSION} ${IMAGE_FRONTEND}:${VERSION} || true"                cleanWs()            }        }        success {            echo "Pipeline Versionné ${env.VERSION} terminé avec SUCCÈS."        }        failure {            echo "Pipeline Versionné ${env.VERSION} a ÉCHOUÉ."        }    }}