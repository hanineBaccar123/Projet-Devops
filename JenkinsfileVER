pipeline {    agent any    environment {        // Récupère le tag (ex: v1.0.0) ou met 'latest'.        VERSION = "${env.TAG_NAME ?: 'latest'}"                IMAGE_BACKEND = "devops-backend"        IMAGE_FRONTEND = "devops-frontend"                // Nom du projet pour isoler les conteneurs        COMPOSE_PROJECT_NAME = "versionne_project"    }    stages {        // 1. Checkout        stage('Checkout') {            steps {                script {                    echo "Déploiement de la version : ${env.VERSION}"                }                checkout scm            }        }        // 2. Setup        stage('Setup') {            steps {                script {                    echo "Nettoyage de l'environnement..."                    // Utilisation de 'bat' pour Windows                    // '|| exit 0' évite l'erreur si aucun conteneur n'est en cours                    bat 'docker-compose down --remove-orphans || exit 0'                }            }        }        // 3. Build en Parallèle        stage('Build Parallel') {            parallel {                stage('Build Backend') {                    steps {                        script {                            echo "Building Backend..."                            // Jenkins remplace ${VERSION} avant d'envoyer la commande à Windows                            bat "docker build -f Dockerfilebackend -t ${IMAGE_BACKEND}:${VERSION} ."                        }                    }                }                stage('Build Frontend') {                    steps {                        script {                            echo "Building Frontend..."                            bat "docker build -f Dockerfilefrontend -t ${IMAGE_FRONTEND}:${VERSION} ."                        }                    }                }            }        }        // 4. Run (Lancement)        stage('Run (Docker)') {            steps {                script {                    echo "Lancement des conteneurs..."                    // Sur Windows, docker-compose récupérera la variable d'env définie plus haut                    bat "docker-compose up -d"                                        echo "Pause de 15 secondes pour le démarrage..."                    sleep 15                }            }        }        // 5. Smoke Test (.bat)        stage('Smoke Test') {            steps {                script {                    echo "Lancement du script de test Windows (.bat)..."                    // MODIFICATION ICI : On lance directement le .bat                    // Remplacez 'smoke_test_full.bat' par le nom EXACT de votre fichier                    bat "smoke_test_full.bat"                }            }        }        // 6. Archivage        stage('Archive Artifacts') {            steps {                script {                    echo "Sauvegarde des logs..."                    // Redirections de logs style Windows                    bat "docker-compose logs backend > backend.log"                    bat "docker-compose logs frontend > frontend.log"                    bat "docker-compose logs mongodb > mongodb.log"                                        archiveArtifacts artifacts: '*.log, *.bat', allowEmptyArchive: true                }            }        }    }    post {        always {            script {                echo "Nettoyage final..."                bat "docker-compose down"                cleanWs()            }        }        success {            echo "Pipeline Versionné ${env.VERSION} : RÉUSSI"        }        failure {            echo "Pipeline Versionné ${env.VERSION} : ÉCHOUÉ"        }    }}