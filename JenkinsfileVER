pipeline {
    agent any

    environment {
        VERSION = "${env.TAG_NAME ?: 'latest'}"

        IMAGE_BACKEND = "devops-backend"
        IMAGE_FRONTEND = "devops-frontend"

        // Inject VERSION inside docker-compose
        COMPOSE_PROJECT_NAME = "versionne_project"
    }

    stages {

        // 1. Checkout
        stage('Checkout') {
            steps {
                script {
                    echo "Déploiement version : ${VERSION}"
                }
                checkout scm
            }
        }

        // 2. Setup
        stage('Setup') {
            steps {
                script {
                    echo "Nettoyage complet de l'environnement..."

                    // REMOVE ALL OLD CONTAINERS to prevent conflicts
                    bat """
                    docker rm -f backend 2>nul || echo backend non present
                    docker rm -f frontend 2>nul || echo frontend non present
                    docker rm -f mongodb 2>nul || echo mongodb non present

                    docker-compose down --remove-orphans || exit 0
                    """
                }
            }
        }

        // 3. Build (Parallel)
        stage('Build Parallel') {
            parallel {

                stage('Build Backend') {
                    steps {
                        script {
                            echo "Building backend..."
                            bat """docker build -f Dockerfilebackend -t ${IMAGE_BACKEND}:${VERSION} ."""
                        }
                    }
                }

                stage('Build Frontend') {
                    steps {
                        script {
                            echo "Building frontend..."
                            bat """docker build -f Dockerfilefrontend -t ${IMAGE_FRONTEND}:${VERSION} ."""
                        }
                    }
                }

            }
        }

        // 4. Run
        stage('Run (Docker)') {
            steps {
                script {
                    echo "Lancement des conteneurs..."

                    // Pass VERSION to docker-compose using environment
                    bat """
                    set VERSION=${VERSION}
                    docker-compose up -d
                    """

                    sleep 15
                }
            }
        }

        // 5. Smoke Test
        stage('Smoke Test') {
            steps {
                script {
                    echo "Exécution du smoke test..."

                    bat """
                    call smoke_test_full.bat
                    if %ERRORLEVEL% NEQ 0 exit 1
                    """
                }
            }
        }

        // 6. Archive Logs
        stage('Archive Artifacts') {
            steps {
                script {
                    echo "Archivage des logs..."

                    bat "docker-compose logs backend > backend.log"
                    bat "docker-compose logs frontend > frontend.log"
                    bat "docker-compose logs mongodb > mongodb.log"

                    archiveArtifacts artifacts: '*.log', allowEmptyArchive: true
                }
            }
        }
    }

    post {
        always {
            script {
                echo "Nettoyage final..."
                bat "docker-compose down"

                try { cleanWs() }
                catch (Exception e) { echo "cleanWs non disponible" }
            }
        }

        success {
            echo "Pipeline Versionné ${VERSION} : RÉUSSI"
        }

        failure {
            echo "Pipeline Versionné ${VERSION} : ÉCHOUÉ"
        }
    }
}
