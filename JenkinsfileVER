pipeline {    agent any    triggers {        // Déclenche le pipeline quand un tag de type vX.Y.Z est poussé        pollSCM('* * * * *')    }    environment {        VERSION = "${env.GIT_TAG}"        REGISTRY = "haninebaccar"        FRONT_IMAGE = "elearning-frontend"        BACK_IMAGE = "elearning-backend"    }    options {        skipDefaultCheckout(true)    }    stages {        stage('Checkout') {            steps {                echo "?? Récupération du code (tag versionné)..."                checkout([                    $class: 'GitSCM',                    branches: [[name: "refs/tags/*"]],                    userRemoteConfigs: [[                        url: 'https://github.com/hanineBaccar123/Projet-Devops',                        credentialsId: 'dockerhub-creds'                    ]]                ])            }        }        stage('Validation du Tag') {            steps {                script {                    if (!env.GIT_BRANCH.startsWith("refs/tags/v")) {                        error("? Ce pipeline ne tourne QUE pour un tag versionné (vX.Y.Z) !")                    }                    echo "?? Build versionné détecté : ${env.GIT_BRANCH}"                }            }        }        stage('Build des images Docker') {            steps {                echo "?? Build frontend et backend versionnés..."                bat """                docker build -t %REGISTRY%/%FRONT_IMAGE%:%VERSION% -f Dockerfilefrontend .                docker build -t %REGISTRY%/%BACK_IMAGE%:%VERSION% -f Dockerfilebackend .                """            }        }        stage('Push Registry') {            steps {                echo "?? Push des images versionnées vers Docker Hub..."                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'USER', passwordVariable: 'PASS')]) {                    bat """                    docker login -u %USER% -p %PASS%                    docker push %REGISTRY%/%FRONT_IMAGE%:%VERSION%                    docker push %REGISTRY%/%BACK_IMAGE%:%VERSION%                    """                }            }        }        stage('Run Containers (docker-compose)') {            steps {                echo "?? Lancement via docker-compose..."                bat """                docker-compose down || exit 0                docker-compose up -d                """            }        }        stage('Smoke Tests') {            steps {                echo "?? Exécution des smoke tests..."                bat "bash smoke_test_full.bat"            }        }        stage('Archive des artefacts') {            steps {                echo "?? Archivage des logs et résultats..."                archiveArtifacts artifacts: 'artifacts/**/*', fingerprint: true            }        }    }    post {        always {            echo "?? Cleanup containers..."            bat "docker-compose down || exit 0"        }        success {            echo "? Pipeline versionné réussi !"        }        failure {            echo "? Pipeline versionné en échec !"        }    }}