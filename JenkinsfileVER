pipeline {    agent any    environment {        // Récupère le nom du tag (ex: v1.0.0). Si pas de tag, utilise 'latest'        VERSION = "${env.TAG_NAME ?: 'latest'}"                 // Noms des images (à adapter selon votre DockerHub ou local)        IMAGE_BACKEND = "devops-backend"        IMAGE_FRONTEND = "devops-frontend"                // Configuration Docker Compose pour utiliser les variables        COMPOSE_PROJECT_NAME = "versionne-${env.BUILD_NUMBER}"    }    stages {        // 1. Checkout : Récupération du code        stage('Checkout') {            steps {                script {                    echo "Checking out tag: ${env.VERSION}"                }                checkout scm            }        }        // 2. Setup : Nettoyage et préparation        stage('Setup') {            steps {                script {                    echo "Setup environment..."                    // Nettoyage des anciens conteneurs/réseaux si existent                    sh 'docker-compose down --remove-orphans || true'                }            }        }        // 3. Build (Parallélisation) : Construction des images Docker        stage('Build Parallel') {            parallel {                stage('Build Backend') {                    steps {                        script {                            echo "Building Backend version ${env.VERSION}..."                            // Construction avec le Dockerfile spécifique visible dans vos captures                            sh "docker build -f Dockerfilebackend -t ${IMAGE_BACKEND}:${VERSION} ."                            sh "docker build -f Dockerfilebackend -t ${IMAGE_BACKEND}:latest ."                        }                    }                }                stage('Build Frontend') {                    steps {                        script {                            echo "Building Frontend version ${env.VERSION}..."                            // Construction avec le Dockerfile spécifique                            sh "docker build -f Dockerfilefrontend -t ${IMAGE_FRONTEND}:${VERSION} ."                            sh "docker build -f Dockerfilefrontend -t ${IMAGE_FRONTEND}:latest ."                        }                    }                }            }        }        // 4. Run : Lancement de l'environnement complet        stage('Run (Docker)') {            steps {                script {                    echo "Deploying environment with Docker Compose..."                    // On passe la version en variable d'environnement pour que le docker-compose l'utilise                    // Note: Assurez-vous que votre docker-compose.yml utilise ${VERSION} ou lancez les images manuellement                    sh "export VERSION=${VERSION} && docker-compose up -d"                                        // Attente que la base de données et le backend soient prêts (pause simple ou script wait-for-it)                    sleep 15                }            }        }        // 5. Smoke Test : Vérification rapide        stage('Smoke Test') {            steps {                script {                    echo "Running Smoke Tests..."                    // Exécution du script visible dans votre dossier                    // Le script doit retourner "exit 0" si succès, autre chose si échec                    bat "chmod +x smoke_test_full.bat"                    bat "./smoke_test_full.bat"                }            }        }        // 6. Archive Artifacts : Sauvegarde des logs et résultats        stage('Archive Artifacts') {            steps {                script {                    echo "Archiving logs and reports..."                                        // Capture des logs des conteneurs pour analyse                    sh "docker-compose logs backend > backend.log"                    sh "docker-compose logs frontend > frontend.log"                    sh "docker-compose logs mongodb > mongodb.log"                                        // Archivage dans Jenkins                    archiveArtifacts artifacts: '*.log, *.sh', allowEmptyArchive: true                }            }        }    }    // Stage Cleanup recommandé (toujours exécuté)    post {        always {            script {                echo "Cleaning up workspace and containers..."                // Arrêt des conteneurs pour libérer les ressources                sh "docker-compose down"                // Nettoyage des images créées pour ne pas saturer le disque (optionnel)                // sh "docker rmi ${IMAGE_BACKEND}:${VERSION} ${IMAGE_FRONTEND}:${VERSION} || true"                cleanWs()            }        }        success {            echo "Pipeline Versionné ${env.VERSION} réussi !"        }        failure {            echo "Pipeline Versionné ${env.VERSION} échoué."        }    }}