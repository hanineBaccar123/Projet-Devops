pipeline {    agent any    environment {        APP_VERSION = "v1.0.0"    }    stages {        stage('Checkout') {            steps {                echo "?? Récupération du code..."                checkout scm            }        }        stage('Install Dependencies') {            steps {                echo "?? Installation des dépendances..."                bat '''                    docker run --rm ^                        -v "%WORKSPACE%:/app" ^                        -w /app/frontend node:20 ^                        npm install                '''            }        }        stage('Build React App') {            steps {                echo "?? Build React..."                bat '''                    docker run --rm ^                        -v "%WORKSPACE%:/app" ^                        -w /app/frontend node:20 ^                        npm run build                '''            }        }        stage('Build Docker Image') {            steps {                echo "?? Construction de l'image Docker..."                bat '''                    docker build -t myapp:%APP_VERSION% .                '''            }        }        stage('Run Container') {            steps {                echo "?? Démarrage du conteneur..."                bat '''                    docker run -d --name myapp_container -p 8080:80 myapp:%APP_VERSION%                '''            }        }        stage('Smoke Test') {            steps {                echo "?? Lancement du smoke test..."                bat '''                    smoke_test_full.bat                '''            }        }    }    post {        always {            echo "?? Pipeline terminé."        }        failure {            echo "? Release échouée : ${APP_VERSION}"        }        success {            echo "? Release déployée : ${APP_VERSION}"        }    }}