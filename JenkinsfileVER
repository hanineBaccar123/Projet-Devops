pipeline {    agent any    environment {        APP_NAME = 'mon-app-react'        VERSION = "${env.TAG_NAME ?: 'v1.0.0'}"        DOCKER_IMAGE = "${APP_NAME}:${VERSION}"    }    stages {        stage('Checkout') {            steps {                echo "?? Récupération du code pour la version ${VERSION}..."                checkout scm            }        }        stage('Setup') {            steps {                echo "?? Installation des dépendances..."                bat '''                docker run --rm -v %cd%:/app -w /app node:18 cmd /c "npm ci --production"                '''            }        }        stage('Build') {            steps {                echo "?? Build de la version ${VERSION}..."                bat '''                docker run --rm -v %cd%:/app -w /app node:18 cmd /c "npm run build"                echo ${VERSION} >> build\\version.txt                '''            }        }        stage('Run Docker') {            steps {                echo "?? Construction et lancement du conteneur..."                bat '''                docker build --tag %DOCKER_IMAGE% .                docker tag %DOCKER_IMAGE% %APP_NAME%:latest                docker run --detach --name %APP_NAME%-release --publish 30003:80 %DOCKER_IMAGE%                timeout /t 5                '''            }        }        stage('Smoke Test') {            steps {                echo "?? Exécution des smoke tests..."                script {                    def result = bat(                        script: 'curl --fail http://localhost:30003 || exit 1',                        returnStatus: true                    )                    if (result == 0) {                        echo "? SMOKE TEST PASSED"                    } else {                        error "? SMOKE TEST FAILED"                    }                }            }        }        stage('Archive Artifacts') {            steps {                echo "?? Archivage des artefacts de release..."                bat '''                mkdir artifacts\\release-%VERSION%                echo Release Version: %VERSION% >> artifacts\\release-%VERSION%\\release-info.txt                echo Status: SUCCESS >> artifacts\\release-%VERSION%\\release-info.txt                echo Date: %DATE% %TIME% >> artifacts\\release-%VERSION%\\release-info.txt                powershell -Command "Compress-Archive -Path build\\* -DestinationPath artifacts\\release-%VERSION%\\build-%VERSION%.zip"                '''                archiveArtifacts artifacts: 'artifacts/**/*', allowEmptyArchive: false            }        }        stage('Cleanup') {            steps {                echo "?? Nettoyage..."                bat '''                docker stop %APP_NAME%-release || exit 0                docker rm %APP_NAME%-release || exit 0                '''            }        }    }    post {        always {            echo "? Pipeline de release terminé"        }        success {            echo "?? Release ${VERSION} réussie"        }        failure {            echo "? Release ${VERSION} échouée"        }    }}