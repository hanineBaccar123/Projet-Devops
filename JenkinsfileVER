pipeline {    agent any    environment {        APP_NAME = "mon-react-app"        VERSION = "${env.TAG_NAME ?: 'v1.0.0'}"        IMAGE = "${APP_NAME}:${VERSION}"    }    stages {        stage('Checkout') {            steps {                echo "?? Récupération du code..."                checkout scm            }        }        stage('Install Dependencies') {            steps {                echo "?? Installation des dépendances..."                bat """                docker run --rm ^                    -v "%cd%":/app ^                    -w /app node:18 `                    npm install                """            }        }        stage('Build React App') {            steps {                echo "??? Build React..."                bat """                docker run --rm ^                    -v "%cd%":/app ^                    -w /app node:18 `                    npm run build                """            }        }        stage('Build Docker Image') {            steps {                echo "?? Construction de l'image Docker..."                bat "docker build -t %IMAGE% ."            }        }        stage('Run Container') {            steps {                echo "?? Lancement du conteneur..."                bat """                docker stop frontend || exit 0                docker rm frontend || exit 0                docker run -d --name frontend -p 30003:80 %IMAGE%                """            }        }        stage('Smoke Test') {            steps {                echo "?? Tests de fumée..."                bat "scripts\\smoke_test_full.bat"            }        }    }    post {        always {            echo "?? Pipeline terminé."        }        success {            echo "? Release OK : ${VERSION}"        }        failure {            echo "? Release échouée : ${VERSION}"        }    }}