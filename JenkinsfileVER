pipeline {    agent any    stages {        stage('Checkout Tag') {            steps {                echo "?? Checkout du tag déclencheur..."                checkout([                    $class: 'GitSCM',                    branches: [[name: "*/tags/*"]],                    userRemoteConfigs: [[                        url: 'https://github.com/hanineBaccar123/Projet-Devops',                        credentialsId: 'dockerhub-creds'                    ]]                ])            }        }        stage('Validate Tag') {            steps {                script {                    echo "?? Détection du tag..."                    TAG = bat(                        returnStdout: true,                        script: 'for /f "tokens=* delims=" %i in (\'git describe --tags --exact-match\') do @echo %i'                    ).trim()                    echo "? Tag extrait : '${TAG}'"                    if (!TAG || !TAG.startsWith("v")) {                        error "? Ce pipeline ne tourne QUE pour les tags versionnés (vX.Y.Z) — Tag actuel : ${TAG}"                    }                    env.VERSION = TAG                    echo "? Tag valide : ${env.VERSION}"                }            }        }        stage('Install Dependencies (frontend + backend)') {            steps {                bat "cd frontend && npm install"                bat "cd backend && npm install"            }        }        stage('Build (frontend)') {            steps {                bat "cd frontend && npm run build"            }        }        stage('Build Docker Images') {            steps {                script {                    echo "?? Build images Docker versionnées : ${env.VERSION}"                    bat """                        docker build -t haninebaccar/elearning-frontend:${env.VERSION} -f Dockerfilefrontend .                        docker build -t haninebaccar/elearning-backend:${env.VERSION} -f Dockerfilebackend .                    """                }            }        }        stage('Push to Registry') {            steps {                withCredentials([usernamePassword(                    credentialsId: 'dockerhub-creds',                    usernameVariable: 'USER',                    passwordVariable: 'PASS'                )]) {                    bat """                        docker login -u %USER% -p %PASS%                        docker push haninebaccar/elearning-frontend:${env.VERSION}                        docker push haninebaccar/elearning-backend:${env.VERSION}                    """                }            }        }        stage('Run Containers (docker-compose)') {            steps {                bat """                    if exist docker-compose.yml (                        docker-compose down || exit 0                        docker-compose up -d                    ) else (                        echo no docker-compose.yml to run                    )                """            }        }        stage('Smoke Tests') {            steps {                bat "smoke_test_full.bat"            }        }        stage('Archive Artifacts') {            steps {                archiveArtifacts artifacts: 'artifacts/**/*', fingerprint: true            }        }    }    post {        always {            echo "?? Cleanup: docker-compose down (si présent)"            bat """                if exist docker-compose.yml (                    docker-compose down || exit 0                ) else (                    echo no docker-compose.yml to run down                )            """        }        success {            echo "?? Pipeline versionné réussi !"        }        failure {            echo "? Pipeline versionné échoué pour ${VERSION}"        }    }}