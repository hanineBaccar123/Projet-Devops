pipeline {
    agent any

    environment {
        // Récupère le tag s'il existe, sinon "latest"
        VERSION = "${env.TAG_NAME ?: 'latest'}"

        IMAGE_BACKEND = "devops-backend"
        IMAGE_FRONTEND = "devops-frontend"

        // Nom pour isoler Docker Compose
        COMPOSE_PROJECT_NAME = "versionne_project"
    }

    stages {

        // 1. Checkout
        stage('Checkout') {
            steps {
                script {
                    echo "Déploiement de la version : ${VERSION}"
                }
                checkout scm
            }
        }

        // 2. Setup
        stage('Setup') {
            steps {
                script {
                    echo "Nettoyage complet de l'environnement..."

                    // Supprime conteneurs bloquants (ex: mongodb déjà utilisé)
                    bat """
                    docker rm -f mongodb 2>nul || echo mongodb non présent
                    docker-compose down --remove-orphans || exit 0
                    """
                }
            }
        }

        // 3. Build (Parallèle)
        stage('Build Parallel') {
            parallel {
                stage('Build Backend') {
                    steps {
                        script {
                            echo "Building Backend..."
                            bat """docker build -f Dockerfilebackend -t ${IMAGE_BACKEND}:${VERSION} ."""
                        }
                    }
                }

                stage('Build Frontend') {
                    steps {
                        script {
                            echo "Building Frontend..."
                            bat """docker build -f Dockerfilefrontend -t ${IMAGE_FRONTEND}:${VERSION} ."""
                        }
                    }
                }
            }
        }

        // 4. Run Containers
        stage('Run (Docker)') {
            steps {
                script {
                    echo "Lancement des conteneurs Docker..."
                    bat "docker-compose up -d"

                    echo "Pause 15 sec pour le démarrage..."
                    sleep 15
                }
            }
        }

        // 5. Smoke Test
        stage('Smoke Test') {
            steps {
                script {
                    echo "Exécution du smoke test Windows..."

                    // Exécute le script et FAIL si code != 0
                    bat """
                    call smoke_test_full.bat
                    if %ERRORLEVEL% NEQ 0 (
                        echo Smoke Test FAILED
                        exit 1
                    )
                    """
                }
            }
        }

        // 6. Archive Logs
        stage('Archive Artifacts') {
            steps {
                script {
                    echo "Archivage des logs Docker..."

                    // Capture des logs pour chaque service
                    bat "docker-compose logs backend > backend.log"
                    bat "docker-compose logs frontend > frontend.log"
                    bat "docker-compose logs mongodb > mongodb.log"

                    archiveArtifacts artifacts: '*.log', allowEmptyArchive: true
                }
            }
        }
    }

    post {
        always {
            script {
                echo "Nettoyage final..."
                bat "docker-compose down"

                // cleanWs si plugin disponible, sinon ignore
                try {
                    cleanWs()
                } catch (Exception e) {
                    echo "cleanWs non disponible, ignoré."
                }
            }
        }

        success {
            echo "Pipeline Versionné ${VERSION} : RÉUSSI"
        }
        failure {
            echo "Pipeline Versionné ${VERSION} : ÉCHOUÉ"
        }
    }
}
