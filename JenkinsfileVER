pipeline {    agent any    environment {        REGISTRY = "haninebaccar"    }    stages {        stage('Checkout Tag') {            steps {                echo "?? Checkout du tag déclencheur..."                checkout([                    $class: 'GitSCM',                    branches: [[name: "refs/tags/*"]],                    userRemoteConfigs: [[                        url: 'https://github.com/hanineBaccar123/Projet-Devops',                        credentialsId: 'dockerhub-creds'                    ]]                ])            }        }        stage('Validate Tag') {            steps {                script {                    echo "?? Détection du tag..."                    // IMPORTANT : %%i pour Windows batch                    def rawTag = bat(                        returnStdout: true,                        script: """                        for /f %%i in ('git describe --tags --exact-match') do @echo %%i                        """                    ).trim()                    echo "? Tag brut : '${rawTag}'"                    if (!rawTag || !rawTag.startsWith("v")) {                        error "? Tag invalide. Ce pipeline ne tourne QUE pour les tags vX.Y.Z — Tag actuel : ${rawTag}"                    }                    env.VERSION = rawTag                    echo "? Tag valide : ${env.VERSION}"                }            }        }        stage('Install Dependencies (frontend + backend)') {            steps {                bat "cd frontend && npm install"                bat "cd backend && npm install"            }        }        stage('Build (frontend)') {            steps {                bat "cd frontend && npm run build"            }        }        stage('Build Docker Images') {            steps {                bat """                docker build -t %REGISTRY%/elearning-frontend:%VERSION% -f Dockerfilefrontend .                docker build -t %REGISTRY%/elearning-backend:%VERSION% -f Dockerfilebackend .                """            }        }        stage('Push to Registry') {            steps {                withCredentials([usernamePassword(                    credentialsId: 'dockerhub-creds',                    usernameVariable: 'USER',                    passwordVariable: 'PASS'                )]) {                    bat """                    docker login -u %USER% -p %PASS%                    docker push %REGISTRY%/elearning-frontend:%VERSION%                    docker push %REGISTRY%/elearning-backend:%VERSION%                    """                }            }        }        stage('Run Containers (docker-compose)') {            steps {                bat """                if exist docker-compose.yml (                    docker-compose down || exit 0                    docker-compose up -d                ) else (                    echo no docker-compose.yml found                )                """            }        }        stage('Smoke Tests') {            steps {                bat "smoke_test_full.bat"            }        }        stage('Archive Artifacts') {            steps {                archiveArtifacts artifacts: 'artifacts/**/*', fingerprint: true            }        }    }    post {        always {            echo "?? Cleanup docker-compose..."            bat """            if exist docker-compose.yml (                docker-compose down || exit 0            ) else (                echo no docker-compose.yml to run down            )            """        }        success {            script {                echo "?? Pipeline versionné réussi pour ${env.VERSION}"            }        }        failure {            script {                echo "? Pipeline versionné échoué pour ${env.VERSION ?: 'TAG NON DÉTECTÉ'}"            }        }    }}