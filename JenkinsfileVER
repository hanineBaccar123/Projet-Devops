pipeline {    agent any    environment {        REGISTRY = "haninebaccar"    }    stages {        stage('Checkout Tag') {            steps {                echo "?? Checkout du tag déclencheur..."                checkout([                    $class: 'GitSCM',                    branches: [[name: "dev/tags/*"]],                    userRemoteConfigs: [[                        url: 'https://github.com/hanineBaccar123/Projet-Devops',                        credentialsId: 'dockerhub-creds'                    ]]                ])            }        }        stage('Validate Tag') {            steps {                script {                    echo "?? Détection du tag…"                    def rawTag = bat(                        returnStdout: true,                        script: """                        @echo off                        for /f %%i in ('git describe --tags --exact-match 2^>NUL') do (                            echo %%i                        )                        """                    ).trim()                    echo "? Tag brut détecté = '${rawTag}'"                    if (!rawTag || !rawTag.startsWith("v")) {                        error "? Tag invalide — Ce pipeline ne tourne QUE pour des tags vX.Y.Z — Tag actuel : ${rawTag}"                    }                    env.VERSION = rawTag                    echo "? Tag validé = ${env.VERSION}"                }            }        }        stage('Install Dependencies (frontend + backend)') {            steps {                bat "cd frontend && npm install"                bat "cd backend && npm install"            }        }        stage('Build (frontend)') {            steps {                bat "cd frontend && npm run build"            }        }        stage('Build Docker Images') {            steps {                script {                    bat """                    docker build -t ${env.REGISTRY}/elearning-frontend:${env.VERSION} -f Dockerfilefrontend .                    docker build -t ${env.REGISTRY}/elearning-backend:${env.VERSION} -f Dockerfilebackend .                    """                }            }        }        stage('Push to Registry') {            steps {                withCredentials([usernamePassword(                    credentialsId: 'dockerhub-creds',                    usernameVariable: 'USER',                    passwordVariable: 'PASS'                )]) {                    bat """                    docker login -u %USER% -p %PASS%                    docker push ${env.REGISTRY}/elearning-frontend:${env.VERSION}                    docker push ${env.REGISTRY}/elearning-backend:${env.VERSION}                    """                }            }        }        stage('Run Containers (docker-compose)') {            steps {                bat """                if exist docker-compose.yml (                    docker-compose down || exit 0                    docker-compose up -d                ) else (                    echo Aucun fichier docker-compose.yml trouvé                )                """            }        }        stage('Smoke Tests') {            steps {                bat "smoke_test_full.bat"            }        }        stage('Archive Artifacts') {            steps {                archiveArtifacts artifacts: 'artifacts/**/*', fingerprint: true            }        }    }    post {        always {            echo "?? Cleanup docker-compose…"            bat """            if exist docker-compose.yml (                docker-compose down || exit 0            ) else (                echo Pas de docker-compose.yml à arrêter            )            """        }        success {            echo "?? Pipeline versionné réussi pour ${env.VERSION}"        }        failure {            echo "?? Pipeline versionné échoué pour ${env.VERSION ?: 'TAG NON DÉTECTÉ'}"        }    }}