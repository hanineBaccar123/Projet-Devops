// JenkinsfilePRpipeline {  agent any  options {    skipStagesAfterUnstable()    buildDiscarder(logRotator(numToKeepStr: '50'))    timestamps()  }  environment {    COMPOSE_FILE = "docker-compose.yml"    ARTIFACT_DIR = "artifacts/pr/${env.BUILD_NUMBER}"  }  stages {    stage('Checkout') {      steps {        checkout scm        sh 'git rev-parse --abbrev-ref HEAD || true'        sh 'mkdir -p ${ARTIFACT_DIR}'      }    }    stage('Setup') {      steps {        echo "Setup environment (no image build)."        sh '''          # capture docker and docker-compose versions          docker --version > ${ARTIFACT_DIR}/docker_version.txt || true          docker-compose --version > ${ARTIFACT_DIR}/docker_compose_version.txt || true        '''      }    }    stage('Build (prepare)') {      steps {        echo "PR pipeline: we do not rebuild images. Prepare config if needed."        sh '''          # copy or generate config if needed          cp -n nginx.conf ./ || true        '''      }    }    stage('Run (Docker)') {      steps {        echo "Start services with --no-build (use already built images)"        sh '''          docker-compose -f ${COMPOSE_FILE} down --remove-orphans || true          docker-compose -f ${COMPOSE_FILE} pull || true          docker-compose -f ${COMPOSE_FILE} up -d --no-build          docker ps --format "table {{.Names}}\t{{.Image}}\t{{.Status}}" > ${ARTIFACT_DIR}/docker_ps.txt        '''      }    }    stage('Smoke Test') {      steps {        echo "Run smoke tests (frontend + backend). Results saved to artifacts."        sh '''          set -o pipefail          ./smoketestbackend.sh 2>&1 | tee ${ARTIFACT_DIR}/smoke_backend.log          backend_rc=${PIPESTATUS[0]}          ./smoketest.sh 2>&1 | tee ${ARTIFACT_DIR}/smoke_frontend.log          frontend_rc=${PIPESTATUS[0]}          if [ ${backend_rc} -ne 0 ] || [ ${frontend_rc} -ne 0 ]; then            echo "Smoke FAILED: backend=${backend_rc} frontend=${frontend_rc}" > ${ARTIFACT_DIR}/smoke_result.txt            exit 1          else            echo "Smoke PASSED" > ${ARTIFACT_DIR}/smoke_result.txt          fi        '''      }    }    stage('Archive Artifacts') {      steps {        archiveArtifacts artifacts: "${ARTIFACT_DIR}/**", fingerprint: true        // Also keep junit-style result if you convert smoke to JUnit xml later      }    }    stage('Cleanup') {      steps {        echo "Stop containers started by this job"        sh '''          docker-compose -f ${COMPOSE_FILE} down        '''      }    }  }  post {    always {      echo "Post actions - ensure containers are cleaned"      sh 'docker-compose -f ${COMPOSE_FILE} down || true'    }    failure {      echo "Pipeline failed - see archived logs"    }  }}