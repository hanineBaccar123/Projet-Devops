pipeline {    agent any    environment {        FRONT_DIR = 'FrontendElearning'        BACK_DIR = 'backendElearning'        COMPOSE_FILE = 'docker-compose.yml'    }    stages {        stage('Checkout') {            steps {                echo '=== Stage 1: Checkout ==='                checkout scm            }        }        stage('Setup') {            parallel {                stage('Setup Frontend') {                    steps {                        dir("${FRONT_DIR}") {                            bat 'npm install'                        }                    }                }                stage('Setup Backend') {                    steps {                        dir("${BACK_DIR}") {                            bat 'npm install'                        }                    }                }            }        }        stage('Build') {            parallel {                stage('Build Frontend') {                    steps {                        dir("${FRONT_DIR}") {                            bat 'npm run build'                        }                    }                }                stage('Build Backend') {                    steps {                        dir("${BACK_DIR}") {                            echo 'Check syntax backend...'                        }                    }                }            }        }        stage('Run (Docker)') {            steps {                echo '=== Stage 4: Docker Compose Up ==='                bat "docker-compose -f ${COMPOSE_FILE} up -d --build"                echo 'Attente de 15 secondes pour que les services démarrent...'                sleep 15            }        }        stage('Smoke Test') {            steps {                echo '=== Stage 5: Smoke Tests (PowerShell) ==='                // On utilise PowerShell nativement pour vérifier les ports 80 (front) et 5000/5001 (back)                powershell '''                    $ErrorActionPreference = "Stop"                    try {                        Write-Host "Test Frontend sur localhost:80..."                        $response = Invoke-WebRequest -Uri "http://localhost:80" -UseBasicParsing                        if ($response.StatusCode -eq 200) { Write-Host "Frontend: Passed" } else { Write-Error "Frontend: Failed"; exit 1 }                    } catch {                        Write-Error "Frontend: Failed (Connection refused or Error)"                        exit 1                    }                    try {                        Write-Host "Test Backend sur localhost:5001..."                        # Adapte le port 5001 si ton backend est sur 5000                        $responseBack = Invoke-WebRequest -Uri "http://localhost:5001" -UseBasicParsing                        if ($responseBack.StatusCode -eq 200) { Write-Host "Backend: Passed" } else { Write-Error "Backend: Failed"; exit 1 }                    } catch {                        Write-Error "Backend: Failed (Connection refused or Error)"                        # On ne met pas exit 1 ici pour voir les logs, mais tu peux le décommenter                        exit 1                    }                '''            }        }        stage('Archive Artifacts') {            steps {                echo '=== Stage 6: Archiving Logs ==='                // Redirection compatible Windows                bat 'docker-compose logs > docker_logs_pr.txt'                archiveArtifacts artifacts: 'docker_logs_pr.txt', fingerprint: true            }        }    }    post {        always {            echo '=== Cleanup ==='            // Force le nettoyage des conteneurs            bat "docker-compose -f ${COMPOSE_FILE} down -v"            // Utilisation de deleteDir() au lieu de cleanWs()            deleteDir()        }    }}