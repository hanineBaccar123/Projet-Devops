pipeline {    agent any    environment {        // Définition des dossiers basés sur ta capture d'écran        FRONT_DIR = 'FrontendElearning'        BACK_DIR = 'backendElearning'        COMPOSE_FILE = 'docker-compose.yml'    }    stages {        stage('Checkout') {            steps {                echo '=== Stage 1: Checkout ==='                checkout scm            }        }        stage('Setup') {            parallel {                stage('Setup Frontend') {                    steps {                        dir("${FRONT_DIR}") {                            sh 'npm install'                        }                    }                }                stage('Setup Backend') {                    steps {                        dir("${BACK_DIR}") {                            sh 'npm install'                        }                    }                }            }        }        stage('Build') {            // Exigence : Parallélisation des builds            parallel {                stage('Build Frontend') {                    steps {                        dir("${FRONT_DIR}") {                            sh 'npm run build' // Assure-toi que ton package.json a ce script                        }                    }                }                stage('Build Backend') {                    steps {                        dir("${BACK_DIR}") {                            echo 'Backend check (Express n\'a pas toujours de build step, mais on vérifie la syntaxe)'                            // Tu peux ajouter un linter ici si besoin                        }                    }                }            }        }        stage('Run (Docker)') {            steps {                echo '=== Stage 4: Docker Compose Up ==='                // On force la reconstruction pour être sûr de tester le nouveau code                sh "docker-compose -f ${COMPOSE_FILE} up -d --build"                // Petite pause pour laisser Mongo démarrer                sleep 10            }        }        stage('Smoke Test') {            steps {                echo '=== Stage 5: Smoke Tests ==='                // Utilisation de ton script existant                sh 'chmod +x smoke_test_full.sh'                sh './smoke_test_full.sh'            }        }        stage('Archive Artifacts') {            steps {                echo '=== Stage 6: Archiving Logs ==='                // On archive les logs docker pour le debug                sh 'docker-compose logs > docker_logs_pr.txt'                archiveArtifacts artifacts: 'docker_logs_pr.txt', fingerprint: true            }        }    }    post {        always {            echo '=== Cleanup ==='            sh "docker-compose -f ${COMPOSE_FILE} down"            cleanWs()        }    }}