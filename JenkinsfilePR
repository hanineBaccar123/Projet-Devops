pipeline {    agent any        triggers {        // Polling Git toutes les minutes pour PR et push        pollSCM('* * * * *')    }        stages {        stage('Checkout') {            steps {                checkout scm            }        }                stage('Setup') {            steps {                echo 'Installing dependencies...'                bat 'docker --version'                bat 'docker-compose --version'            }        }                stage('Build') {            steps {                echo 'Building Docker images...'                bat 'docker-compose build backend frontend'            }        }                stage('Run (Docker)') {            steps {                echo 'Stopping existing containers if any...'                                // Arrêter tous les conteneurs liés au projet                bat 'docker-compose down --remove-orphans || exit 0'                                // Supprimer les conteneurs spécifiques s'ils existent (au cas où)                bat 'docker rm -f mongodb || exit 0'                bat 'docker rm -f backend || exit 0'                bat 'docker rm -f frontend || exit 0'                                // Supprimer les réseaux orphelins                bat 'docker network prune -f || exit 0'                                echo 'Starting containers...'                // Lancer les nouveaux conteneurs                bat 'docker-compose up -d'                                // Afficher l'état des conteneurs                bat 'docker-compose ps'            }        }                stage('Smoke Test') {            steps {                script {                    echo 'Waiting for services to be ready...'                    // Attendre que les services démarrent                    sleep 15                                        echo 'Running smoke tests...'                                        // Test backend (ajustez le port si nécessaire)                    try {                        def backendStatus = bat(                            script: '@curl -s -o NUL -w "%%{http_code}" http://localhost:5001',                            returnStdout: true                        ).trim()                        echo "Backend HTTP Status Code: ${backendStatus}"                    } catch (Exception e) {                        echo "Backend test failed or not accessible: ${e.message}"                    }                                        // Test frontend                    try {                        def frontendStatus = bat(                            script: '@curl -s -o NUL -w "%%{http_code}" http://localhost:5371',                            returnStdout: true                        ).trim()                        echo "Frontend HTTP Status Code: ${frontendStatus}"                                                if(frontendStatus != '200') {                            error "Frontend smoke test failed! HTTP code: ${frontendStatus}"                        } else {                            echo "? Frontend is responding correctly"                        }                    } catch (Exception e) {                        error "Frontend test failed: ${e.message}"                    }                                        // Vérifier que MongoDB est accessible                    try {                        bat 'docker exec mongodb mongosh --eval "db.adminCommand({ ping: 1 })" || exit 0'                        echo "? MongoDB is responding"                    } catch (Exception e) {                        echo "MongoDB health check failed: ${e.message}"                    }                }            }        }                stage('Archive Artifacts') {            steps {                echo 'Archiving artifacts...'                // Archiver les logs Docker Compose                bat 'docker-compose logs > docker-compose-logs.txt || exit 0'                archiveArtifacts artifacts: '**/logs/**, docker-compose-logs.txt', allowEmptyArchive: true            }        }                stage('Cleanup') {            steps {                echo 'Cleaning up old resources...'                // Nettoyer les images inutilisées (optionnel)                bat 'docker image prune -f || exit 0'            }        }    }        post {        success {            echo '? Pipeline completed successfully!'            echo 'Application is running at:'            echo '  - Frontend: http://localhost:5371'            echo '  - Backend: http://localhost:5001'        }                failure {            echo '? Pipeline failed!'            // Récupérer les logs en cas d'échec            bat 'docker-compose logs || exit 0'            // Ne pas arrêter les conteneurs en cas d'échec pour debug            echo 'Containers left running for debugging. Run "docker-compose down" manually when done.'        }                always {            echo 'Post-build cleanup...'            // Optionnel : décommenter pour arrêter les conteneurs après chaque build            // bat 'docker-compose down --remove-orphans || exit 0'        }    }}