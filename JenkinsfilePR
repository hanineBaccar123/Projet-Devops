pipeline {    agent any    options {        skipStagesAfterUnstable()        buildDiscarder(logRotator(numToKeepStr: '50'))    }    environment {        COMPOSE_FILE = "docker-compose.yml"        ARTIFACT_DIR = "artifacts/pr/${BUILD_NUMBER}"    }    stages {        stage('Checkout') {            steps {                checkout scm                sh 'mkdir -p ${ARTIFACT_DIR}'            }        }        stage('Setup') {            steps {                echo "Checking Docker and Docker Compose versions"                sh """                    docker --version > ${ARTIFACT_DIR}/docker_version.txt || true                    docker compose version > ${ARTIFACT_DIR}/docker_compose_version.txt || true                """            }        }        stage('Build (prepare)') {            steps {                echo "PR pipeline: no image build because containers already exist"                sh 'cp -n nginx.conf ./ || true'            }        }        stage('Run (Docker)') {            steps {                echo "Starting containers using existing images (no build)"                sh """                    docker compose -f ${COMPOSE_FILE} down --remove-orphans || true                    docker compose -f ${COMPOSE_FILE} pull || true                    docker compose -f ${COMPOSE_FILE} up -d --no-build                    docker ps > ${ARTIFACT_DIR}/docker_ps.txt                """            }        }        stage('Smoke Test') {            steps {                echo "Running smoke tests..."                sh """                    set -e                    echo "Testing backend..."                    ./smoketestbackend.sh > ${ARTIFACT_DIR}/smoke_backend.log 2>&1                    backend_rc=$?                    echo "Testing frontend..."                    ./smoketest.sh > ${ARTIFACT_DIR}/smoke_frontend.log 2>&1                    frontend_rc=$?                    if [ $backend_rc -ne 0 ] || [ $frontend_rc -ne 0 ]; then                        echo "FAILED" > ${ARTIFACT_DIR}/smoke_result.txt                        exit 1                    else                        echo "PASSED" > ${ARTIFACT_DIR}/smoke_result.txt                    fi                """            }        }        stage('Archive Artifacts') {            steps {                archiveArtifacts artifacts: "${ARTIFACT_DIR}/**", fingerprint: true            }        }        stage('Cleanup') {            steps {                echo "Cleaning up containers"                sh "docker compose -f ${COMPOSE_FILE} down || true"            }        }    }    post {        always {            echo "Final cleanup"            sh "docker compose -f ${COMPOSE_FILE} down || true"        }        failure {            echo "Pipeline failed — See logs in artifacts."        }    }}