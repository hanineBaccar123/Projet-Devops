pipeline {    agent any    environment {        FRONT_DIR = 'FrontendElearning'        BACK_DIR = 'backendElearning'        COMPOSE_FILE = 'docker-compose.yml'    }    stages {        stage('Checkout') {            steps {                echo '=== Stage 1: Checkout ==='                checkout scm            }        }        stage('Setup') {            parallel {                stage('Setup Frontend') {                    steps {                        dir("${FRONT_DIR}") {                            // "bat" est utilisé pour Windows au lieu de "sh"                            bat 'npm install'                        }                    }                }                stage('Setup Backend') {                    steps {                        dir("${BACK_DIR}") {                            bat 'npm install'                        }                    }                }            }        }        stage('Build') {            parallel {                stage('Build Frontend') {                    steps {                        dir("${FRONT_DIR}") {                            bat 'npm run build'                        }                    }                }                stage('Build Backend') {                    steps {                        dir("${BACK_DIR}") {                            echo 'Backend check...'                        }                    }                }            }        }        stage('Run (Docker)') {            steps {                echo '=== Stage 4: Docker Compose Up ==='                // Utilisation de bat pour docker-compose                bat "docker-compose -f ${COMPOSE_FILE} up -d --build"                sleep 10            }        }        stage('Smoke Test') {            steps {                echo '=== Stage 5: Smoke Tests ==='                // Sur Windows, on ne fait pas de chmod.                // On essaie de lancer le script .sh via bash (nécessite que Git Bash soit dans le PATH)                // Sinon, tu devras peut-être convertir le .sh en .bat                bat 'bash smoke_test_full.sh'            }        }        stage('Archive Artifacts') {            steps {                echo '=== Stage 6: Archiving Logs ==='                // Redirection des logs adaptée pour Windows                bat 'docker-compose logs > docker_logs_pr.txt'                archiveArtifacts artifacts: 'docker_logs_pr.txt', fingerprint: true            }        }    }    post {        always {            echo '=== Cleanup ==='            bat "docker-compose -f ${COMPOSE_FILE} down"            cleanWs()        }    }}