pipeline {    agent any     // Ou 'agent { docker ... }' si vous n'avez pas docker installé sur l'hôte Jenkins    environment {        // Variables pour identifier le build        COMPOSE_PROJECT_NAME = "pr_${BUILD_NUMBER}"    }    stages {        stage('Checkout') {            steps {                checkout scm                echo "Checkout terminé pour la branche PR"            }        }        stage('Setup') {            steps {                // Vérification de la présence de Docker                sh 'docker --version'                sh 'docker compose version'            }        }        stage('Build Parallel') {            parallel {                stage('Build Frontend') {                    steps {                        dir('FrontendElearning') {                            // Adaptation au nom de votre fichier Dockerfile                            sh 'docker build -f ../Dockerfilefrontend -t frontend:pr-${BUILD_NUMBER} .'                        }                    }                }                stage('Build Backend') {                    steps {                        dir('backendElearning') {                            sh 'docker build -f ../Dockerfilebackend -t backend:pr-${BUILD_NUMBER} .'                        }                    }                }            }        }        stage('Run (Docker)') {            steps {                // Lancement avec docker-compose en mode détaché                // Assurez-vous que votre docker-compose.yml utilise les images taggées ou build localement                sh 'docker compose -f docker-compose.yml up -d --build'                                // Petite pause pour laisser MongoDB et le backend démarrer                sleep 15            }        }        stage('Smoke Test') {            steps {                script {                    try {                        // Exécution du script de test                        // chmod +x est important si vous venez de Windows                        sh 'chmod +x smoketest.sh'                        sh './smoketest.sh'                        currentBuild.result = 'SUCCESS'                    } catch (Exception e) {                        currentBuild.result = 'FAILURE'                        error("Smoke Test Failed")                    }                }            }        }        stage('Archive Artifacts') {            steps {                // On capture les logs des conteneurs pour le débogage                sh 'docker compose logs > build_logs.txt'                archiveArtifacts artifacts: 'build_logs.txt', allowEmptyArchive: true            }        }    }    post {        always {            stage('Cleanup') {                sh 'docker compose down --volumes --rmi local'                cleanWs() // Nettoyage du workspace Jenkins            }        }    }}