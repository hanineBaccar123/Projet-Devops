pipeline {    agent any    environment {        FRONT_DIR = 'FrontendElearning'        BACK_DIR = 'backendElearning'        COMPOSE_FILE = 'docker-compose.yml'    }    stages {        stage('Checkout') {            steps {                echo '=== Stage 1: Checkout ==='                checkout scm            }        }        stage('Setup') {            parallel {                stage('Setup Frontend') {                    steps {                        dir("${FRONT_DIR}") {                            bat 'npm install'                        }                    }                }                stage('Setup Backend') {                    steps {                        dir("${BACK_DIR}") {                            bat 'npm install'                        }                    }                }            }        }        stage('Build') {            parallel {                stage('Build Frontend') {                    steps {                        dir("${FRONT_DIR}") {                            bat 'npm run build'                        }                    }                }                stage('Build Backend') {                    steps {                        dir("${BACK_DIR}") {                            echo 'Check syntax backend...'                        }                    }                }            }        }        stage('Run (Docker)') {            steps {                echo '=== Stage 4: Docker Compose Up ==='                bat "docker-compose -f ${COMPOSE_FILE} up -d --build"                echo 'Attente de 20 secondes pour la stabilisation...'                sleep 20            }        }        stage('Smoke Test') {            steps {                echo '=== Stage 5: Smoke Tests (PowerShell) ==='                                // DIAGNOSTIC : On regarde si les conteneurs tournent vraiment                echo '--- ETAT DES CONTENEURS ---'                bat 'docker ps -a'                powershell '''                    $ErrorActionPreference = "Continue" // On continue pour tester le backend même si le front échoue pour avoir les logs                    $failed = $false                    Write-Host "--- TEST FRONTEND (Port 80) ---"                    try {                        $response = Invoke-WebRequest -Uri "http://localhost:80" -UseBasicParsing                        if ($response.StatusCode -eq 200) {                             Write-Host "Frontend: SUCCESS"                         } else {                             Write-Host "Frontend: FAILED (Status code: $($response.StatusCode))"                            $failed = $true                        }                    } catch {                        Write-Host "Frontend: CRASH - Impossible de se connecter a localhost:80"                        Write-Host "Erreur detaillee : $($_.Exception.Message)"                        $failed = $true                    }                    Write-Host "--- TEST BACKEND (Port 5001) ---"                    try {                        // VERIFIE ICI SI TON PORT EST 5000 OU 5001 DANS DOCKER-COMPOSE                        $responseBack = Invoke-WebRequest -Uri "http://localhost:5001" -UseBasicParsing                        if ($responseBack.StatusCode -eq 200) {                             Write-Host "Backend: SUCCESS"                         } else {                             Write-Host "Backend: FAILED (Status code: $($responseBack.StatusCode))"                            $failed = $true                        }                    } catch {                        Write-Host "Backend: CRASH - Impossible de se connecter a localhost:5001"                        Write-Host "Erreur detaillee : $($_.Exception.Message)"                        $failed = $true                    }                    if ($failed) {                        Write-Error "Au moins un test a echoue."                        exit 1                    }                '''            }        }        // J'ai supprimé le stage "Archive" ici car il est déplacé dans le Post pour s'exécuter même en cas d'erreur    }    post {        always {            echo '=== Sauvegarde des logs et Nettoyage ==='                        // 1. On capture les logs des conteneurs (C'est ICI qu'on verra pourquoi Nginx plante)            bat 'docker-compose logs > docker_logs_debug.txt'            archiveArtifacts artifacts: 'docker_logs_debug.txt', fingerprint: true                        // 2. Nettoyage            bat "docker-compose -f ${COMPOSE_FILE} down -v"            deleteDir()        }    }}