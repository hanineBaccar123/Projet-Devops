pipeline {    agent any    triggers {        // Polling Git toutes les minutes pour PR et push        pollSCM('* * * * *')    }    stages {        stage('Checkout') {            steps {                checkout scm            }        }        stage('Setup') {            steps {                echo 'Installing dependencies...'                bat 'docker --version'                bat 'docker-compose --version'            }        }        stage('Build') {            steps {                // Ajouter --pull pour récupérer les dernières images si nécessaire                bat 'docker-compose build backend frontend'            }        }        stage('Run (Docker)') {            steps {                // Arrêter et supprimer les anciens conteneurs avant de lancer les nouveaux                bat 'docker-compose down --remove-orphans'                bat 'docker-compose up -d'            }        }        stage('Smoke Test') {            steps {                script {                    // Test si le frontend répond sur localhost:5317                    def result = bat(                        script: 'curl -s -o NUL -w "%{http_code}" http://localhost:5317',                        returnStdout: true                    ).trim()                    echo "HTTP Status Code: ${result}"                    if(result != '200') {                        error "Smoke test failed! HTTP code: ${result}"                    }                }            }        }        stage('Archive Artifacts') {            steps {                // Archiver logs ou autres fichiers générés                archiveArtifacts artifacts: '**\\logs\\**', allowEmptyArchive: true            }        }        stage('Cleanup') {            steps {                // Nettoyer pour éviter conflits dans les builds suivants                bat 'docker-compose down --remove-orphans'            }        }    }    post {        always {            // Assurer le cleanup même si le pipeline échoue            bat 'docker-compose down --remove-orphans'        }    }}