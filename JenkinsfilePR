pipeline {    agent any    triggers {        // Polling Git toutes les minutes (PR)        pollSCM('* * * * *')     }    stages {        stage('Checkout') {            steps {                checkout scm            }        }        stage('Setup') {            steps {                bat 'echo Installing dependencies...'                bat 'docker --version'                bat 'docker-compose --version'            }        }        stage('Build') {            steps {                bat 'docker-compose build backend frontend'            }        }        stage('Run (Docker)') {            steps {                bat 'docker-compose up -d'            }        }        stage('Smoke Test') {            steps {                script {                    // Pour Windows, rediriger la sortie curl vers NUL                    def result = bat(script: 'curl -s -o NUL -w "%{http_code}" http://localhost:3000', returnStdout: true).trim()                    if(result != '200') {                        error "Smoke test failed!"                    }                }            }        }        stage('Archive Artifacts') {            steps {                // Chemins Windows : utiliser \ ou doubles \\                 archiveArtifacts artifacts: '**\\logs\\**', allowEmptyArchive: true            }        }        stage('Cleanup') {            steps {                bat 'docker-compose down'            }        }    }}