pipeline {    agent any     environment {        // Nom du projet pour docker-compose afin d'éviter les conflits        COMPOSE_PROJECT_NAME = "pr_${BUILD_NUMBER}"    }    stages {        stage('Checkout') {            steps {                checkout scm                echo "Checkout terminé sur la branche : ${env.BRANCH_NAME}"            }        }        stage('Setup') {            steps {                // Vérification des versions                sh 'docker --version'                sh 'docker compose version'            }        }        stage('Build Parallel') {            parallel {                stage('Build Frontend') {                    steps {                        // Assurez-vous que le chemin est correct vers le Dockerfile                        sh 'docker build -f Dockerfilefrontend -t frontend:pr-${BUILD_NUMBER} .'                    }                }                stage('Build Backend') {                    steps {                        sh 'docker build -f Dockerfilebackend -t backend:pr-${BUILD_NUMBER} .'                    }                }            }        }        stage('Run (Docker)') {            steps {                // Lancement des conteneurs                sh 'docker compose -f docker-compose.yml up -d --build'                                echo "Attente du démarrage des services..."                sleep 15            }        }        stage('Smoke Test') {            steps {                script {                    try {                        // Rendre le script exécutable (important sous Linux/GitBash)                        sh 'chmod +x smoketest.sh'                        sh './smoketest.sh'                        currentBuild.result = 'SUCCESS'                    } catch (Exception e) {                        currentBuild.result = 'FAILURE'                        error("Smoke Test Failed")                    }                }            }        }        stage('Archive Artifacts') {            steps {                // Capture des logs                sh 'docker compose logs > build_logs.txt'                archiveArtifacts artifacts: 'build_logs.txt', allowEmptyArchive: true            }        }    }    // CORRECTION ICI : Pas de "stage" dans le post    post {        always {            echo 'Nettoyage de l\'environnement...'            sh 'docker compose down --volumes'            cleanWs() // Nettoie le workspace Jenkins        }    }}