# Étape 1: Build React
FROM node:18-alpine AS build
WORKDIR /app
COPY ./FrontendElearning/package*.json ./
RUN npm install
COPY ./FrontendElearning .
RUN npm run build   # Cela génère le dossier /app/dist avec Vite

# Étape 2: Nginx
FROM nginx:alpine

#  Copier depuis /app/dist (pas /app/build)
COPY --from=build /app/dist /usr/share/nginx/html

# Copier le fichier de config Nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]